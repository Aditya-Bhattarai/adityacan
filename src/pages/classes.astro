---
// CLASSES: Frame as a building with three floors (scene 4, afternoon). Pick a floor and its window lights up.
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { getProject, getSettings } from '../lib/content.js';
import { day } from '../lib/day.js';

const settings = getSettings();
const frame = await getProject('frame-course');
const seniors = await getProject('senior-digital-literacy');

// ---------- WORDS: change the text between the quotes and save ----------
const words = {
  title: 'Frame.',
  intro: 'My video editing course. 18 modules over three levels, from CapCut to After Effects.',
  introShort: 'My video editing course. 18 modules over three levels.',
  button: 'Join the next batch',
  also: 'I also teach social media to older people who never grew up with it.',
};
// The three floors, top floor first.
const floors = [
  { id: 'f3', k: 'k3', number: '03', title: 'Advanced', text: 'Motion graphics in After Effects, and colour grading.', image: 'u/teach-timeline.jpg', alt: 'A timeline on screen, mid edit.', bg: '#ECE9E1' },
  { id: 'f2', k: 'k2', number: '02', title: 'Professional', text: 'Moving to Premiere Pro, working with sound and cutting a story.', image: 'u/teach-setup.jpg', alt: 'An editing setup ready for class.', bg: '#E4E1D8' },
  { id: 'f1', k: 'k1', number: '01', title: 'Foundations', text: 'Cutting in CapCut, with pacing, hooks and captions.', image: 'u/rc-7.jpg', alt: 'An editing class, mid lesson.', bg: '#DCD8CC', focus: '50% 30%' },
];

// The button opens WhatsApp with a first line already typed.
const joinHref = settings.whatsapp
  ? `https://wa.me/${settings.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent('Hi Aditya, I’d like to join the next Frame batch.')}`
  : settings.calendly;
---

<Base
  title="Classes"
  description="Frame, Aditya Bhattarai’s video editing course: 18 modules over three levels, from CapCut to After Effects. Plus social media classes for older people."
  current="teaching" scene="4" slug="INT. CLASSROOM. AFTERNOON." grain
  sky="linear-gradient(180deg, #9DC2E2 0px, #C9DDEC 200px, #F1F0EC 480px)"
>
  <div class="bld">
    <input type="radio" name="floor" id="f1" checked aria-label="Floor 1, Foundations" />
    <input type="radio" name="floor" id="f2" aria-label="Floor 2, Professional" />
    <input type="radio" name="floor" id="f3" aria-label="Floor 3, Advanced" />

    <Picture image={day('moon_disc.jpg')} alt="The moon, faint in the afternoon sky. My own photograph." widths={[120]} sizes="60px" class="moon d-only" />

    <!-- The name and the lift dial -->
    <div class="left">
      <h1>{words.title}</h1>
      <p class="intro d-only">{words.intro}</p>
      <p class="intro m-only">{words.introShort}</p>
      <div class="lift d-only" aria-hidden="true">
        <div class="lift__face"></div>
        <span class="num" style="left: 28px; top: 54px">1</span>
        <span class="num" style="left: 92px; top: 18px">2</span>
        <span class="num" style="right: 24px; top: 54px">3</span>
        <span class="needle"></span>
        <span class="lift__pin"></span>
      </div>
      <a class="join d-only" href={joinHref} target="_blank" rel="noopener">{words.button}</a>
      {frame && <a class="more d-only" href={frame.href}>About the course →</a>}
    </div>

    <!-- The one crooked thing -->
    <figure class="crooked d-only">
      <Picture image={day('c/green_studio.jpg')} alt="The green screen studio, lights up." widths={[240, 480]} sizes="16vw" style="aspect-ratio: 1 / 1" />
    </figure>

    <!-- The building -->
    <div class="tower">
      <p class="howto"><span class="d-only">Three floors. Click one to look inside.</span><span class="m-only">Three floors. Tap one to look inside.</span></p>
      <div class="sign-row"><div class="sign" aria-hidden="true">{'FRAME'.split('').map((letter) => <span>{letter}</span>)}</div></div>
      <div class="floors">
        {floors.map((floor) => (
          <label class={`fl ${floor.k}`} for={floor.id} style={`background:${floor.bg}`}>
            <div class="win">
              {floor.k === 'k3' && <svg viewBox="0 0 300 160" width="100%" height="100%" aria-hidden="true"><rect x="40" y="26" width="220" height="64" fill="none" stroke="#121212" stroke-width="2"></rect><path d="M60 70 L110 44 L150 62 L200 34 L240 52" fill="none" stroke="#121212" stroke-width="2"></path><circle cx="110" cy="128" r="9" fill="none" stroke="#121212" stroke-width="2"></circle><circle cx="190" cy="128" r="9" fill="none" stroke="#121212" stroke-width="2"></circle><path d="M110 118 L110 98 M190 118 L190 98" stroke="#121212" stroke-width="1.5" stroke-dasharray="2 4"></path></svg>}
              {floor.k === 'k2' && <svg viewBox="0 0 300 160" width="100%" height="100%" aria-hidden="true"><rect x="40" y="30" width="220" height="56" fill="none" stroke="#121212" stroke-width="2"></rect><path d="M52 58 h30 M90 58 h52 M150 58 h20 M178 58 h70" stroke="#121212" stroke-width="8"></path><path d="M52 76 q20 -12 40 0 t40 0 t40 0 t40 0 t40 0" fill="none" stroke="#121212" stroke-width="1.5"></path><circle cx="150" cy="128" r="9" fill="none" stroke="#121212" stroke-width="2"></circle><path d="M150 118 L150 96" stroke="#121212" stroke-width="1.5" stroke-dasharray="2 4"></path></svg>}
              {floor.k === 'k1' && <svg viewBox="0 0 300 160" width="100%" height="100%" aria-hidden="true"><rect x="118" y="18" width="64" height="110" rx="8" fill="none" stroke="#121212" stroke-width="2"></rect><path d="M130 100 h40 M130 108 h28" stroke="#121212" stroke-width="3"></path><circle cx="70" cy="128" r="9" fill="none" stroke="#121212" stroke-width="2"></circle><circle cx="230" cy="128" r="9" fill="none" stroke="#121212" stroke-width="2"></circle><path d="M78 122 L116 90 M222 122 L184 90" stroke="#121212" stroke-width="1.5" stroke-dasharray="2 4"></path></svg>}
              <Picture image={day(floor.image)} alt={floor.alt} widths={[320, 640]} sizes="(max-width: 900px) 90vw, 21vw" eager={floor.k === 'k1'} style={floor.focus ? `object-position:${floor.focus}` : undefined} />
            </div>
            <div class="info">
              <span class="num">{floor.number}</span>
              <span class="ttl">{floor.title}</span>
              <span class="peek">see this floor <i aria-hidden="true">→</i></span>
              <span class="tags">{floor.text}</span>
            </div>
            <span class="lamp"></span>
          </label>
        ))}
      </div>
      <div class="ground d-only"></div>
    </div>

    <!-- Next door: the other classes -->
    <p class="house">
      {seniors ? <a href={seniors.href}>{words.also}</a> : words.also}
    </p>

    <div class="mcta m-only">
      <a class="join" href={joinHref} target="_blank" rel="noopener">{words.button}</a>
      {frame && <a class="more" href={frame.href}>About the course →</a>}
    </div>
    <div class="mcard m-only">
      <Picture image={day('c/green_studio.jpg')} alt="The green screen studio, lights up." widths={[480, 840]} sizes="100vw" style="aspect-ratio: 4 / 5" />
      <span class="vf"></span>
      <span class="mcard__t"><b>The studio</b><small>lights set</small></span>
    </div>
  </div>
</Base>

<style>
  .bld { position: relative; }
  .bld input { position: fixed; top: 50%; left: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  h1 { margin: 0; font-weight: 600; line-height: 0.86; letter-spacing: -0.05em; }
  .intro { margin: 0; font-family: var(--font-serif); line-height: 1.2; }
  .num { font: 500 15px/1 var(--font-mono); letter-spacing: 0.3em; }
  .join { align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; border-radius: 999px; background: var(--ink); color: var(--paper); text-decoration: none; font-size: 14px; font-weight: 500; }
  .more { align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px; font: 400 11px/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); text-underline-offset: 5px; }
  .house { margin: 0; font: 400 10px/1.7 var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .house a { color: inherit; text-underline-offset: 4px; }

  .sign-row { display: flex; justify-content: center; margin-bottom: -2px; }
  .sign { border: 2px solid var(--ink); border-bottom: none; background: #ece9e1; font-weight: 600; }
  .sign span { transition: color 0.3s, text-shadow 0.3s; }
  .sign:hover span { color: #a86a12; text-shadow: 0 0 10px rgba(232, 178, 58, 0.9); }
  .sign span:nth-child(2) { transition-delay: 0.12s; } .sign span:nth-child(3) { transition-delay: 0.24s; } .sign span:nth-child(4) { transition-delay: 0.36s; } .sign span:nth-child(5) { transition-delay: 0.48s; }
  .floors { border: 2px solid var(--ink); border-bottom: none; background: var(--paper); }
  .fl { position: relative; display: flex; border-bottom: 2px solid var(--ink); }
  .win { position: relative; border: 2px solid var(--ink); background: #f7f5ef; overflow: hidden; }
  .win :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.8s ease; }
  .win svg { position: absolute; inset: 0; transition: opacity 0.5s; }
  .info { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 10px; }
  .ttl { font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .tags { font: 400 19px/1.25 var(--font-serif); opacity: 0; transform: translateY(6px); transition: opacity 0.5s, transform 0.5s; }
  .howto { margin: 0 0 12px; text-align: center; font: 400 12px/1.4 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .peek { font: 400 12px/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: #3a3a37; text-decoration: underline; text-underline-offset: 4px; }
  .peek i { display: inline-block; font-style: normal; transition: translate 0.3s; }
  .fl:hover .peek i { translate: 5px 0; }
  .fl:hover .ttl { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  #f1:checked ~ .tower .k1 .peek, #f2:checked ~ .tower .k2 .peek, #f3:checked ~ .tower .k3 .peek { display: none; }
  #f1:not(:checked) ~ .tower .k1 .lamp, #f2:not(:checked) ~ .tower .k2 .lamp, #f3:not(:checked) ~ .tower .k3 .lamp { animation: blinklamp 2.4s ease-in-out infinite; }
  @keyframes blinklamp { 50% { background: rgba(232, 178, 58, 0.45); } }
  .lamp { position: absolute; right: 22px; top: 22px; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--ink); background: transparent; transition: background 0.4s; }
  #f1:checked ~ .tower .k1 .win :global(img), #f2:checked ~ .tower .k2 .win :global(img), #f3:checked ~ .tower .k3 .win :global(img) { opacity: 1; }
  #f1:checked ~ .tower .k1 svg, #f2:checked ~ .tower .k2 svg, #f3:checked ~ .tower .k3 svg { opacity: 0; }
  #f1:checked ~ .tower .k1 .tags, #f2:checked ~ .tower .k2 .tags, #f3:checked ~ .tower .k3 .tags { opacity: 1; transform: none; }
  #f1:checked ~ .tower .k1 .lamp, #f2:checked ~ .tower .k2 .lamp, #f3:checked ~ .tower .k3 .lamp { background: var(--gold); }
  .bld input:focus-visible ~ .tower { outline: 1px dashed var(--muted); outline-offset: 8px; }

  @media (min-width: 900px) {
    .bld { height: calc(1100 * var(--u)); min-height: 760px; overflow: hidden; }
    .bld :global(.moon) { position: absolute; left: calc(1326 * var(--u)); top: max(96px, calc(84 * var(--u))); width: 60px; height: 60px; border-radius: 50%; mix-blend-mode: screen; opacity: 0.9; pointer-events: none; }
    .left { position: absolute; left: 28px; top: max(130px, calc(130 * var(--u))); width: calc(520 * var(--u)); display: flex; flex-direction: column; gap: calc(22 * var(--u)); }
    h1 { font-size: calc(168 * var(--u)); }
    .intro { font-size: max(19px, calc(32 * var(--u))); }
    .lift { position: relative; width: 200px; height: 112px; margin-top: calc(26 * var(--u)); }
    .lift__face { position: absolute; inset: 0; border: 2px solid var(--ink); border-bottom: none; border-radius: 100px 100px 0 0; background: #f7f5ef; }
    .lift .num { position: absolute; }
    .needle { position: absolute; left: 50%; bottom: 0; width: 2px; height: 74px; margin-left: -1px; background: var(--ink); transform-origin: 50% 100%; transform: rotate(-55deg); transition: transform 1.1s cubic-bezier(0.5, -0.4, 0.3, 1.4); }
    #f2:checked ~ .left .needle { transform: rotate(0deg); }
    #f3:checked ~ .left .needle { transform: rotate(55deg); }
    .lift__pin { position: absolute; left: 50%; bottom: -7px; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: var(--ink); }
    .join { margin-top: calc(18 * var(--u)); }
    .more { margin-top: calc(-14 * var(--u)); }
    .crooked { position: absolute; left: calc(330 * var(--u)); top: calc(760 * var(--u)); width: calc(230 * var(--u)); margin: 0; rotate: -4deg; background: #fff; padding: calc(10 * var(--u)) calc(10 * var(--u)) calc(34 * var(--u)); box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.5); }
    .crooked :global(img) { display: block; width: 100%; height: auto; object-fit: cover; }
    .tower { position: absolute; left: calc(640 * var(--u)); top: max(104px, calc(96 * var(--u))); width: calc(620 * var(--u)); }
    .sign { padding: 10px 30px 8px calc(30px + 0.6em); font-size: max(15px, calc(22 * var(--u))); letter-spacing: 0.6em; }
    .fl { height: calc(206 * var(--u)); }
    .win { width: calc(300 * var(--u)); margin: calc(22 * var(--u)) 0 calc(22 * var(--u)) calc(22 * var(--u)); }
    .info { padding: 0 calc(26 * var(--u)); }
    .ttl { font-size: max(22px, calc(34 * var(--u))); }
    .tags { font-size: max(14px, calc(19 * var(--u))); }
    .ground { height: 2px; background: var(--ink); margin: 0 -400px 0 -60px; }
    .house { position: absolute; left: calc(1290 * var(--u)); top: calc(580 * var(--u)); width: calc(128 * var(--u)); font-size: max(8px, calc(10 * var(--u))); }
  }

  @media (max-width: 899.98px) {
    .bld { padding: 116px 22px 44px; display: flex; flex-direction: column; gap: 22px; }
    .left { display: flex; flex-direction: column; gap: 10px; }
    h1 { font-size: 84px; }
    .intro { font-size: 20px; }
    .sign { padding: 6px 16px 6px calc(16px + 0.5em); font-size: 13px; letter-spacing: 0.5em; }
    .floors { border-bottom: 0; }
    .fl { flex-direction: column; gap: 10px; padding: 14px 16px; }
    .info { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 6px 14px; order: -1; padding-right: 26px; }
    .info .num { font: 600 12px/1 var(--font-sans); }
    .ttl { font-size: 22px; }
    .tags { flex-basis: 100%; font-size: 17px; display: none; }
    .win { aspect-ratio: 16 / 9; display: none; }
    .win svg { display: none; }
    .lamp { right: 16px; top: 18px; width: 12px; height: 12px; }
    #f1:checked ~ .tower .k1 .win, #f2:checked ~ .tower .k2 .win, #f3:checked ~ .tower .k3 .win { display: block; }
    #f1:checked ~ .tower .k1 .tags, #f2:checked ~ .tower .k2 .tags, #f3:checked ~ .tower .k3 .tags { display: block; }
    .house { font: 400 15px/1.5 var(--font-sans); letter-spacing: 0; text-transform: none; color: var(--ink); }
    .house a { display: inline-block; padding: 8px 0; }
    .mcta { display: flex; flex-direction: column; gap: 4px; }
    .join { font-size: 15px; }
    .mcard { position: relative; margin: 0 -22px; color: #f4efe6; overflow: hidden; background: #0a0a09; }
    .mcard :global(img) { display: block; width: 100%; height: auto; object-fit: cover; }
    .mcard::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 62%; background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.72)); pointer-events: none; }
    .mcard__t { position: absolute; left: 30px; right: 30px; bottom: 28px; z-index: 3; display: flex; flex-direction: column; gap: 7px; }
    .mcard__t b { font-weight: 600; font-size: 40px; line-height: 0.94; letter-spacing: -0.05em; }
    .mcard__t small { font: 400 12px/1.45 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
  }
</style>
