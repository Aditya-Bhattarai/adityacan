---
// The page people see if a link is wrong.
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { getImages } from '../lib/content.js';

// Your black and white street photo, also in the Trekking Guide photographs.
const photo = getImages('03-trekking-guide/photography/photos').find((item) => item.path.includes('street-silhouette'));
---

<Base title="Page not found" noindex>
  <section class="title-card-section">
    <div class="title-card">
      <div class="title-card__kicker">PAGE NOT FOUND</div>
      <h1 class="title-card__title">Nothing here.</h1>
      <p class="title-card__statement">The link might be old, or I might have moved the page.</p>
      {photo && <div class="frame lost-photo" style="aspect-ratio:4/5;border-radius:4px"><Picture image={photo.image} alt="A street at dusk in black and white, photographed by Aditya" widths={[280, 560]} sizes="240px" style="filter:grayscale(1)" /></div>}
      <div class="title-card__rule"></div>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/">Back to the start</a>
        <a class="btn btn--ghost" href="/work">See the work</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost-photo { width: min(240px, 70%); margin-inline: auto; }
</style>
