---
// The page people see if a link is wrong.
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="title-card-section">
    <div class="title-card">
      <div class="title-card__kicker">REEL MISSING</div>
      <h1 class="title-card__title">Lost in the edit.</h1>
      <p class="title-card__statement">This page didn’t make the final cut.</p>
      <div class="title-card__rule"></div>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/">Back to the start</a>
        <a class="btn btn--ghost" href="/work">See the work</a>
      </div>
    </div>
  </section>
</Base>
