---
// ONE PIECE OF WRITING (scene 9, night): the text on a typewriter page, on a dark desk, the lamp on.
// Scripts and stories live in site-content/writing/<name>/piece.md
//
// How a script is written in piece.md:
//   INT. or EXT. at the start of a line   a new scene
//   @NAME                                 someone speaks; their lines follow underneath
//   (softly)                              a direction inside a speech
//   = English words                       a handwritten English note under the line above it
//   > CUT TO:                             a transition
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import { getProject, getWriting } from '../../lib/content.js';
import { clip, day } from '../../lib/day.js';

export async function getStaticPaths() {
  const pieces = await getWriting();
  return pieces.map((piece) => ({ params: { slug: piece.slug }, props: { slug: piece.slug } }));
}

const { slug } = Astro.props;
const pieces = await getWriting();
const piece = pieces.find((item) => item.slug === slug);
const project = piece.project ? await getProject(piece.project) : null;
const typeName = { screenplay: 'Screenplay', 'short-fiction': 'Short story', essay: 'Essay' }[piece.type] ?? 'Writing';
const meta = [typeName, piece.year, piece.minutes ? `${piece.minutes} min read` : piece.pages ? `${piece.pages} pages` : ''].filter(Boolean).join(' · ');
const next = pieces[(pieces.indexOf(piece) + 1) % pieces.length];

// "सपना / Sapana" shows the Nepali name large and the English one in the browser tab.
const [first, second] = piece.title.split(' / ');
const plainTitle = second ?? first;
const hasNepali = /[ऀ-ॿ]/.test(first);

const isScript = piece.type === 'screenplay' && piece.paragraphs.length > 0;
const blocks = isScript ? piece.paragraphs.map((text) => {
  if (text.startsWith('@')) {
    const [name, ...rest] = text.split(/\r?\n/);
    const lines = [];
    for (const raw of rest.map((line) => line.trim()).filter(Boolean)) {
      if (raw.startsWith('=') && lines.length) lines[lines.length - 1].note = raw.slice(1).trim();
      else lines.push({ kind: raw.startsWith('(') ? 'direction' : 'line', text: raw });
    }
    return { kind: 'speech', name: name.slice(1).trim(), lines };
  }
  if (text.startsWith('>')) return { kind: 'transition', text: text.slice(1).trim() };
  if (/^(INT|EXT)[.\s]/.test(text)) return { kind: 'scene', text };
  return { kind: 'action', text };
}) : [];

const lampPoster = await getImage({ src: day('c/lamp_poster.jpg'), width: 480, format: 'webp' });
---

<Base
  title={piece.type === 'screenplay' ? `${plainTitle}, screenplay` : plainTitle}
  description={piece.description || `${plainTitle}, by Aditya Bhattarai.`}
  current={slug === 'sapana' ? 'screenplay' : 'writing'} theme="dark" scene="9" slug="INT. DESK. NIGHT." grain
  sky="radial-gradient(46% 44% at 90% 27%, #3B2913 0%, #1D1711 48%, #0C0B0A 100%)"
>
  <div class="tw">
    <figure class="lamp d-only">
      <video data-loop data-src={clip('c/lamp.mp4')} poster={lampPoster.src} muted loop playsinline preload="none" aria-label="My desk lamp, lit, in a dark room. My own footage."></video>
      <figcaption>My desk lamp</figcaption>
    </figure>

    <!-- What it is, quietly, in the margin -->
    <header class="margin">
      <h1 class:list={[{ dv: hasNepali }]} lang={hasNepali ? 'ne' : undefined}>{first}</h1>
      {hasNepali && second && <span class="visually-hidden">{second}</span>}
      <span class="mono">{meta}</span>
      {piece.contentNote && <span class="mono note">{piece.contentNote}</span>}
      {project?.chapterKey === 'film'
        ? <a class="mono back" href="/film">← back to the film</a>
        : <a class="mono back" href="/writing">← all writing</a>}
    </header>

    <!-- A red cloth notebook -->
    <div class="kk d-only" aria-hidden="true">
      <div class="kk-page">
        <Picture image={day('u/sketch-horse.jpg')} alt="" widths={[190, 380]} sizes="190px" />
        <Picture image={day('u/sketch-kyanjin.jpg')} alt="" widths={[190, 380]} sizes="190px" />
      </div>
      <div class="kk-cover"><span></span></div>
    </div>

    <div class="machine">
      <div class="platen" aria-hidden="true"><span class="bar"></span><span class="rule"></span><span class="knob knob--l"></span><span class="knob knob--r"><i></i></span></div>
      <article class="sheet">
        <span class="pageno" aria-hidden="true">1.</span>
        {isScript && blocks.map((block) => (
          block.kind === 'scene' ? <p class="sceneline">{block.text}</p>
          : block.kind === 'speech' ? (
            <div class="speech">
              <p class="who">{block.name}</p>
              {block.lines.map((line) => line.kind === 'direction'
                ? <p class="direction">{line.text}</p>
                : <p class:list={['line', { 'line--note': line.note }]} tabindex={line.note ? 0 : undefined}>{line.text}{line.note && <span class="en" lang="en">{line.note}</span>}</p>)}
            </div>
          )
          : block.kind === 'transition' ? <p class="transition">{block.text}</p>
          : <p>{block.text}</p>
        ))}
        {!isScript && piece.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {!isScript && piece.paragraphs.length === 0 && piece.description && <p>{piece.description}</p>}
        <p class="end"><span class="caret" aria-hidden="true"></span></p>

        {piece.pdf && (
          <div class="pdf">
            <a href={piece.pdf.url}>Read it as it was typed (PDF) ↗</a>
            {project && <a href={project.href}>See the film’s page →</a>}
          </div>
        )}
      </article>
    </div>

    <a class="next" href={next.href}>
      <span class="mono">Next on the desk</span>
      <span class="next__t">{next.title.split(' / ').pop()} →</span>
    </a>
  </div>
</Base>

<script src="../../scripts/loops.js"></script>

<style>
  .tw { position: relative; padding: 96px 28px 90px; color: var(--night-ink); }
  .mono { font: 400 10px/1.5 var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--night-muted); }
  .margin { display: flex; flex-direction: column; gap: 10px; }
  .margin h1 { margin: 0; font-weight: 600; font-size: 44px; line-height: 1; letter-spacing: -0.04em; }
  .margin h1.dv { font-weight: 400; letter-spacing: 0; line-height: 1.2; }
  .note { max-width: 190px; text-transform: none; letter-spacing: 0.04em; }
  .back { color: var(--night-ink); padding: 12px 0; text-decoration: none; }
  .back:hover { text-decoration: underline; text-underline-offset: 5px; }

  .machine { position: relative; width: min(900px, 100%); margin: 0 auto; }
  .platen { position: relative; height: 66px; z-index: 2; }
  .bar { position: absolute; left: 40px; right: 40px; top: 0; height: 64px; border-radius: 32px; background: linear-gradient(180deg, #3a3835 0%, #121110 45%, #1e1c1a 70%, #0a0a09 100%); box-shadow: 0 18px 30px -16px rgba(0, 0, 0, 0.6); }
  .rule { position: absolute; left: 70px; right: 70px; top: 56px; height: 10px; background: linear-gradient(180deg, #8c8a84, #c9c6be); border-radius: 0 0 4px 4px; opacity: 0.9; }
  .knob { position: absolute; top: -6px; width: 76px; height: 76px; border-radius: 50%; box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.7); }
  .knob--l { left: 0; background: radial-gradient(circle at 35% 35%, #4a4844, #121110 65%); }
  .knob--r { right: 0; background: repeating-conic-gradient(#2a2826 0 8deg, #121110 8deg 16deg); transition: rotate 1.4s steps(9); }
  .machine:hover .knob--r { rotate: 320deg; }
  .knob--r i { position: absolute; left: 50%; top: 50%; width: 26px; height: 26px; margin: -13px 0 0 -13px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #6a6862, #1e1c1a); }

  .sheet { position: relative; width: 80%; margin: -26px auto 0; background: #fbf8f0; padding: 96px 60px 110px 96px; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.04), 0 30px 60px -30px rgba(0, 0, 0, 0.4); font: 400 16px/1.55 var(--font-script); color: #1d1b19; text-shadow: 0 0 0.6px rgba(29, 27, 25, 0.55), 0.35px 0 0 rgba(29, 27, 25, 0.18); }
  .sheet p { margin: 0 0 1.55em; }
  .pageno { position: absolute; right: 60px; top: 70px; }
  .sceneline { font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; }
  .speech { margin-bottom: 1.55em; }
  .speech p { margin: 0; }
  .who { padding-left: 44%; text-transform: uppercase; }
  .direction { padding-left: 34%; }
  .line { position: relative; padding: 0 16% 0 26%; outline: none; }
  .transition { text-align: right; text-transform: uppercase; }
  .en { display: block; padding-top: 2px; font: 500 22px/1.05 var(--font-hand); color: #7a776f; text-shadow: none; rotate: -1deg; transform-origin: 0 50%; }
  .caret { display: inline-block; width: 0.6em; height: 1.1em; background: #1d1b19; vertical-align: -0.18em; animation: blink 1.05s infinite; }
  @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  .end { margin-bottom: 0 !important; }
  .pdf { display: flex; flex-wrap: wrap; gap: 6px 28px; margin-top: 3em; padding-top: 1.4em; border-top: 1px dashed #b9b4a6; text-shadow: none; }
  .pdf a { display: inline-flex; align-items: center; min-height: 44px; color: #1d1b19; text-underline-offset: 4px; }

  .next { display: flex; flex-direction: column; gap: 10px; width: min(720px, 100%); margin: 70px auto 0; padding-top: 26px; border-top: 1px solid #3a3835; color: var(--night-ink); text-decoration: none; }
  .next__t { font: italic 400 clamp(34px, 5vw, 56px) / 1.05 var(--font-serif); }
  .next:hover .next__t { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 7px; }

  @media (min-width: 1180px) {
    .margin { position: absolute; left: 28px; top: 210px; width: 200px; }
    .lamp { position: absolute; right: 18px; top: 122px; width: clamp(150px, 16vw, 236px); margin: 0; pointer-events: none; }
    .lamp video { display: block; width: 100%; aspect-ratio: 9 / 16; object-fit: cover; mix-blend-mode: screen; -webkit-mask-image: radial-gradient(closest-side, #000 58%, transparent 100%); mask-image: radial-gradient(closest-side, #000 58%, transparent 100%); }
    .lamp figcaption { padding-top: 4px; text-align: center; font: 400 9px/1.4 var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--night-muted); }
    .kk { position: absolute; left: 46px; top: 400px; width: 190px; height: 262px; rotate: -5deg; perspective: 900px; }
    .kk-page { position: absolute; inset: 0; background: #f6f0e0; padding: 16px 14px; display: flex; flex-direction: column; gap: 12px; overflow: hidden; box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.5); }
    .kk-page :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; mix-blend-mode: multiply; }
    .kk-cover { position: absolute; inset: 0; background: #8e2a22; background-image: repeating-linear-gradient(45deg, rgba(0, 0, 0, 0.09) 0 2px, transparent 2px 5px), repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.05) 0 2px, transparent 2px 5px); border-radius: 2px 6px 6px 2px; transform-origin: 0 50%; transition: transform 1.1s cubic-bezier(0.3, 0.6, 0.2, 1); box-shadow: inset 7px 0 0 rgba(0, 0, 0, 0.25), 0 20px 40px -20px rgba(0, 0, 0, 0.6); backface-visibility: hidden; pointer-events: auto; }
    .kk-cover span { position: absolute; left: 34px; top: 30px; width: 110px; height: 40px; background: #efe6cf; border-radius: 2px; }
    .kk:hover .kk-cover { transform: rotateY(-160deg); }
    /* The handwritten English only shows when you point at a line. */
    .line--note .en { position: absolute; left: 26%; right: 4%; top: 100%; margin-top: -1px; padding: 0; opacity: 0; transition: opacity 0.4s ease; z-index: 1; }
    .line--note:hover .en, .line--note:focus-visible .en { opacity: 1; }
  }
  @media (max-width: 1179.98px) {
    .lamp, .kk { display: none !important; }
    .tw { padding-top: 120px; }
    .margin { width: min(720px, 100%); margin: 0 auto 30px; }
  }
  @media (max-width: 899.98px) {
    .tw { padding: 116px 16px 60px; }
    .margin { padding: 0 6px; margin-bottom: 22px; }
    .platen { height: 42px; }
    .bar { left: -6px; right: -6px; height: 40px; border-radius: 20px; }
    .rule, .knob--l { display: none; }
    .knob { width: 48px; height: 48px; top: -4px; }
    .knob--r i { width: 16px; height: 16px; margin: -8px 0 0 -8px; }
    .sheet { width: calc(100% - 20px); margin-top: -18px; padding: 54px 22px 60px; font-size: 12.5px; line-height: 1.5; }
    .pageno { right: 22px; top: 30px; }
    .who { padding-left: 38%; }
    .direction { padding-left: 22%; }
    .line { padding: 0 6% 0 16%; }
    .en { font-size: 18px; }
    .next { margin-top: 44px; padding: 22px 6px 0; }
  }
</style>
