---
// HOMEPAGE: one shooting day, from dawn (top) to night (bottom).
// The words are in the block just below. The pictures are in src/assets/day/.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { getImages, getPage, getSettings } from '../lib/content.js';
import { at, clip, day } from '../lib/day.js';

// ---------- WORDS: change the text between the quotes and save ----------
const words = {
  title: ['Films and videos', 'people actually', 'watch.'],
  opening: ['FADE IN:', 'EXT. BHAIRAVKUNDA. DAWN.', 'ADITYA BHATTARAI, a filmmaker, is already up. It is 06:39.'],
  status: 'taking new work',
  videosEdited: '400+',
  impressions: '750M+',
  statement: 'I plan what you should make, make it, see how it did, and use that to make the next one better.',
  creators: 'Content strategy · editing · motion graphics · thumbnails',
  classes: 'I teach editing. Frame has three levels.',
  mountains: 'Trekking guide · filmed and edited on the way up',
  closing: 'Strategy and story from the same person.',
};

// The times down the right edge. "y" is how far down the page each one sits.
const times = [
  { y: 625, time: '06:39', label: 'sunrise', tone: 'day' },
  { y: 923, time: '07:30', label: 'call time', tone: 'day' },
  { y: 1283, time: '08:30', label: 'edit bay', tone: 'day' },
  { y: 1993, time: '10:45', label: 'on set', tone: 'day' },
  { y: 2323, time: '12:05', label: 'noon · lunch', tone: 'day' },
  { y: 2783, time: '13:30', label: 'class', tone: 'day' },
  { y: 3393, time: '15:40', label: 'Langtang', tone: 'day' },
  { y: 4123, time: '17:21', label: 'golden hour', tone: 'gold' },
  { y: 4393, time: '18:02', label: 'sunset', tone: 'gold' },
  { y: 5003, time: '18:25', label: 'last light', tone: 'night' },
  { y: 5757, time: '23:10', label: 'wrap', tone: 'night' },
];

// The six video thumbnails in the edit bay. Each opens the video on YouTube.
const thumbs = [
  { img: 'yt/sk1.webp', name: 'Satik Kura', alt: 'Satik Kura thumbnail about the Rasuwa flood.', href: 'https://www.youtube.com/watch?v=3-CGYoLWVko', pos: at(40, 1516, 200, -1.4) },
  { img: 'yt/ip1.webp', name: 'Ideapreneur', alt: 'Ideapreneur thumbnail: ten problems, ten reforms.', href: 'https://www.youtube.com/watch?v=gSUiU-hIgoQ', pos: at(258, 1536, 200, 0.8) },
  { img: 'yt/sk2.webp', name: 'Satik Kura', alt: 'Satik Kura thumbnail about Yeti Airlines.', href: 'https://www.youtube.com/watch?v=T1wxWdD7V_Y', pos: at(476, 1512, 200, -0.6) },
  { img: 'yt/ip2.webp', name: 'Ideapreneur', alt: 'Ideapreneur thumbnail about a sovereign wealth fund.', href: 'https://www.youtube.com/watch?v=dIpT2v2_geA', pos: at(62, 1690, 200, 1.1) },
  { img: 'yt/sk3.webp', name: 'Satik Kura', alt: 'Satik Kura thumbnail about Himalayan Java.', href: 'https://www.youtube.com/watch?v=2ju2PtXWpRs', pos: at(282, 1712, 200, -0.9) },
  { img: 'yt/ip3.webp', name: 'Ideapreneur', alt: 'Ideapreneur thumbnail about margin trading.', href: 'https://www.youtube.com/watch?v=uHrm39pG2-w', pos: at(498, 1686, 200, 0.5) },
];

const settings = getSettings();
// The short film on Instagram: its link is in site-content/pages/film.yaml (reel > link).
const shortLink = (await getPage('film')).reel?.link;

// The reel lives in site-content/00-home/hero-reel/. It is tall, and is never stretched.
const heroFiles = import.meta.glob('/site-content/00-home/hero-reel/{hero-tall.mp4,hero-tall.webm,hero-tall-hevc.mp4}', { eager: true, query: '?url', import: 'default' });
const heroUrl = (name) => heroFiles[`/site-content/00-home/hero-reel/${name}`];
const posterTall = getImages('00-home/hero-reel').find((item) => item.path.includes('poster-tall')).image;
const reelPoster = await getImage({ src: posterTall, format: 'webp', widths: [280, 560], quality: 72 });
const reelSizes = '(max-width: 900px) 128px, 280px';

// The sunrise behind the title: wide on PCs, tall on phones.
const dawnWide = await getImage({ src: day('home_dawn.jpg'), format: 'webp', widths: [960, 1440, 1920], quality: 70 });
const dawnTall = await getImage({ src: day('home_dawn_tall.jpg'), format: 'webp', widths: [480, 780], quality: 70 });
---

<Base current="home" scene="1" sky="#07080C" ink="#ECEBE6" note="golden hour at 17:21" rail={false} footerDark>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/webp" imagesrcset={dawnWide.srcSet.attribute} imagesizes="100vw" media="(min-width: 900px)" fetchpriority="high" />
    <link rel="preload" as="image" type="image/webp" imagesrcset={dawnTall.srcSet.attribute} imagesizes="100vw" media="(max-width: 899.98px)" fetchpriority="high" />
  </Fragment>

  <div class="day">
    <!-- The sky, the sun's path, and the times down the right edge (PCs and laptops) -->
    <span class="stars stars--dawn d-only" aria-hidden="true"></span>
    <span class="stars stars--night d-only" aria-hidden="true"></span>
    <svg class="arc d-only" aria-hidden="true" viewBox="0 0 1440 5814" preserveAspectRatio="none">
      <path d="M 390 632 C 900 700, 1320 1500, 1320 2330 C 1320 3200, 1050 3950, 720 4170" fill="none" stroke="#D9A441" stroke-opacity="0.75" stroke-width="2" stroke-linecap="round" stroke-dasharray="0.1 10"></path>
    </svg>
    <span class="sun d-only" aria-hidden="true"></span>
    <span class="ruler d-only" aria-hidden="true"></span>
    {times.map((item) => (
      <span class:list={['tc d-only', `tc--${item.tone}`]} style={`--y:${item.y}`}><b>{item.time}</b><i>{item.label}</i></span>
    ))}

    <!-- 1. FADE IN. His own sunrise above Bhairavkunda -->
    <section class="s1">
      <picture>
        <source media="(max-width: 899.98px)" type="image/webp" srcset={dawnTall.srcSet.attribute} sizes="100vw" />
        <source type="image/webp" srcset={dawnWide.srcSet.attribute} sizes="100vw" />
        <img class="dawn" src={dawnWide.src} width="1920" height="1075" fetchpriority="high" decoding="async" alt="First light behind a line of Himalayan peaks, a sea of haze below. Filmed by Aditya above Bhairavkunda." />
      </picture>
      <span class="glow d-only" aria-hidden="true"></span>

      <p class="sp opening">{words.opening.map((line, index) => <span class={index === 2 ? 'd-only' : ''}>{line}</span>)}</p>
      <h1 class="title">{words.title.map((line) => <span>{line} </span>)}</h1>

      <span class="msun m-only" aria-hidden="true"></span>
      <span class="mtc m-only"><b>06:39</b><i>sunrise</i></span>

      <div class="reel">
        <div class="reel__label">
          <span class="recdot"></span><b>Reel</b>
          <button type="button" data-hero-sound aria-pressed="false">23 sec · tap for sound</button>
        </div>
        <div class="reel__frame">
          <picture>
            <source type="image/webp" srcset={reelPoster.srcSet.attribute} sizes={reelSizes} />
            <img class="hero__poster" src={reelPoster.src} alt="My reel, opening on a client video." decoding="async" width="1080" height="1920" />
          </picture>
          <video
            data-hero-video
            data-mp4={heroUrl('hero-tall.mp4')}
            data-webm={heroUrl('hero-tall.webm')}
            data-hevc={heroUrl('hero-tall-hevc.mp4')}
            muted loop playsinline preload="none"
            aria-label="My reel: client videos first, then Langtang. Plays without sound until you ask for it."
          ></video>
        </div>
      </div>

      <div class="pill pill--hero">
        <span class="pill__live">{words.status}</span>
        <a href="/me#work"><span class="clap" aria-hidden="true"><i></i></span>Work with me</a>
      </div>
    </section>

    <!-- Call time: the slate carries the numbers -->
    <section class="s-call">
      <a class="slate at" href="/for-creators" style={at(40, 896, 400)}>
        <span class="slate__st slate__st--up"></span><span class="slate__st"></span>
        <span class="slate__sb">
          <span class="fd" style="grid-column: span 6"><small>Prod.</small><b>adityacan.com</b></span>
          <span class="fd" style="grid-column: span 2"><small>Roll</small><b>A001</b></span>
          <span class="fd" style="grid-column: span 2"><small>Scene</small><b>1</b></span>
          <span class="fd" style="grid-column: span 2"><small>Take</small><b>1</b></span>
          <span class="fd fd--big" style="grid-column: span 3"><small>Videos edited</small><b>{words.videosEdited}</b></span>
          <span class="fd fd--big" style="grid-column: span 3"><small>Impressions</small><b>{words.impressions}</b></span>
          <span class="fd fd--x" style="grid-column: span 4"><small>Director</small><b>{settings.name}</b></span>
          <span class="fd fd--x" style="grid-column: span 2"><small>Date</small><b>today</b></span>
        </span>
      </a>
      <p class="statement at" style={at(520, 960, 430)}>{words.statement}</p>
      <a class="f at d-only" href="/near-mountains" style={at(1000, 944, 220, 1.6)}>
        <Picture image={day('best/ktm_basantapur.jpg')} alt="Basantapur Durbar Square under big white clouds." widths={[240, 480]} sizes="16vw" style="aspect-ratio: 4 / 3" />
        <span class="cap"><span class="name">Kathmandu</span><span class="verb">where I work</span><span>07:30</span></span>
      </a>
    </section>

    <!-- 2. The edit bay -->
    <section class="s2">
      <p class="slug" style="--y:1290"><b>2</b><span>INT. EDIT BAY. MORNING.</span></p>
      <h2 class="tt at" style={at(36, 1330, 700)}><a href="/for-creators">For creators<span class="go" aria-hidden="true">→</span></a></h2>
      <p class="vb at d-only" style={at(42, 1446, 660)}>{words.creators}</p>
      <div class="thumbs">
        {thumbs.map((item, index) => (
          <a class:list={['f at', { 'd-only': index > 1 }]} href={item.href} target="_blank" rel="noopener" style={item.pos}>
            <Picture image={day(item.img)} alt={item.alt} widths={[200, 400]} sizes="(max-width: 900px) 40vw, 14vw" style="aspect-ratio: 16 / 9; border-radius: 4px" />
            <span class="cap d-only"><span class="name">{item.name}</span><span class="verb">thumbnail ↗</span></span>
          </a>
        ))}
      </div>
      <a class="f at d-only" href="/for-creators" style={at(740, 1300, 480, 0.7)}>
        <span class="shot">
          <Picture image={day('u/mg-donut.jpg')} alt="An animated chart from an Ideapreneur Nepal video." widths={[480, 960]} sizes="34vw" style="aspect-ratio: 16 / 9" />
          <span class="burn"><span class="tl">A003 C012</span><span class="tr">24.00 FPS</span><span class="bl">TC 08:41:12:08</span><span class="br"><span class="recdot"></span></span></span>
        </span>
        <span class="cap"><span class="name">Ideapreneur</span><span class="verb">edit and motion graphics</span><span>02</span></span>
      </a>
      <a class="f at d-only" href="/for-creators" style={at(730, 1622, 290, -1.2)}>
        <Picture image={day('c/desk.jpg')} alt="My desk at night: the rope lamp, the screen, the hat sitting on the computer." widths={[300, 600]} sizes="20vw" style="aspect-ratio: 4 / 3" />
        <span class="cap"><span class="name">My desk</span><span class="verb">where it gets cut</span><span>03</span></span>
      </a>
      <a class="f at d-only" href={shortLink ?? '/films'} target={shortLink ? '_blank' : undefined} rel={shortLink ? 'noopener' : undefined} style={at(1060, 1612, 150, 2)}>
        <span class="shot">
          <Picture image={day('c/cat.jpg')} alt="A cat asleep in the sun, from my short film on Instagram." widths={[160, 320]} sizes="11vw" style="aspect-ratio: 9 / 16; object-position: 40% 50%" />
          <span class="story"><i></i></span>
        </span>
        <span class="cap"><span class="name">A short</span><span class="verb">on Instagram ↗</span></span>
      </a>
    </section>

    <!-- 3. On set -->
    <section class="s3">
      <p class="slug" style="--y:2000"><b>3</b><span>EXT. PINE FOREST. DAY.</span></p>
      <a class="f at wide d-only" href="/films" style={at(40, 2036, 1180)}>
        <span class="kb">
          <Picture image={day('u/sapana-clearing.jpg')} alt="Sapana walking alone through the pines." widths={[900, 1400]} sizes="82vw" style="aspect-ratio: 2.39 / 1" />
          <span class="burn burn--bars">
            <span class="tl">A007 C003 · 2.39:1</span><span class="tr">TC 10:45:02:16</span>
            <span class="bl"><span class="dv" lang="ne">सपना</span> · writer and director</span><span class="br">Path to Prosperity · assistant director</span>
          </span>
          <span class="wide__title">Films<span aria-hidden="true">→</span></span>
        </span>
      </a>
      <a class="f at d-only" href="/films" style={at(930, 2622, 250, 1.6)}>
        <Picture image={day('u/ptp-screen.jpg')} alt="Path to Prosperity on the festival screen." widths={[260, 520]} sizes="18vw" style="aspect-ratio: 16 / 9" />
        <span class="cap"><span class="name">Path to Prosperity</span><span class="verb">assistant director</span><span>05</span></span>
      </a>
      <a class="f at d-only" href="/films" style={at(500, 2626, 220, -1.6)}>
        <Picture image={day('c/walkie.jpg')} alt="A walkie talkie in my hand, the crew waiting on a forest road." widths={[240, 480]} sizes="16vw" style="aspect-ratio: 900 / 768" />
        <span class="cap"><span class="name">On set</span><span class="verb">walkie in hand</span><span>04</span></span>
      </a>
      <a class="card m-only" href="/films">
        <Picture image={day('u/sapana-clearing.jpg')} alt="Sapana walking alone through the pines." widths={[480, 800]} sizes="100vw" style="aspect-ratio: 4 / 3" />
        <span class="vf"></span>
        <span class="card__t"><b>Films</b><small><span class="dv" lang="ne">सपना</span> · writer and director</small></span>
      </a>
    </section>

    <!-- 4. Class -->
    <section class="s4">
      <p class="slug" style="--y:2790"><b>4</b><span>INT. CLASSROOM. AFTERNOON.</span></p>
      <a class="f at d-only" href="/classes" style={at(40, 2830, 290, -1.2)}>
        <Picture image={day('best/greenscreen.jpg')} alt="A green screen studio with the lights set." widths={[300, 600]} sizes="20vw" style="aspect-ratio: 3 / 4" />
        <span class="cap"><span class="name">The studio</span><span class="verb">lights set</span><span>06</span></span>
      </a>
      <a class="f at d-only" href="/classes" style={at(370, 2900, 320, 1.3)}>
        <Picture image={day('u/teach-setup.jpg')} alt="The editing desk set up for a Frame class: lamp on, timeline open." widths={[320, 640]} sizes="22vw" style="aspect-ratio: 1 / 1" />
        <span class="cap"><span class="name">Frame</span><span class="verb">the editing desk</span><span>07</span></span>
      </a>
      <h2 class="tt at d-only" style={at(760, 2838, 460)}><a href="/classes">Classes<span class="go" aria-hidden="true">→</span></a></h2>
      <p class="vb at d-only" style={at(766, 2954, 440)}>{words.classes}</p>
      <a class="f at d-only wire-link" href="/everything" style={at(840, 3040, 360, -0.8)}>
        <span class="ins">Insert: the gate. Wait.</span>
        <span class="wire">
          <Picture image={day('c/gate_night.jpg')} alt="Night, in black and white: one small figure in a gateway between two lamps, trees overhead." widths={[360, 720]} sizes="25vw" style="aspect-ratio: 4 / 3" />
        </span>
      </a>
      <a class="card m-only" href="/classes">
        <Picture image={day('best/greenscreen.jpg')} alt="The green screen studio where I teach." widths={[480, 800]} sizes="100vw" style="aspect-ratio: 4 / 5" />
        <span class="vf"></span>
        <span class="card__t"><b>Classes</b><small>{words.classes}</small></span>
      </a>
    </section>

    <!-- 5. Langtang -->
    <section class="s5">
      <p class="slug" style="--y:3400"><b>5</b><span>EXT. LANGTANG. LATE AFTERNOON.</span></p>
      <h2 class="tt at d-only" style={at(36, 3440, 900)}><a href="/near-mountains">Near Mountains.<span class="go" aria-hidden="true">→</span></a></h2>
      <p class="vb at d-only" style={at(42, 3556, 700)}>{words.mountains}</p>
      <a class="f at d-only" href="/near-mountains" style={at(40, 3606, 210, -1)}>
        <span class="shot">
          <video class="loop" data-loop data-src={clip('best/loop_icefall.mp4')} muted loop playsinline preload="none" aria-label="The icefall above Kyanjin Gompa, my footage, silent." style="aspect-ratio: 9 / 16"></video>
          <Picture image={day('best/v_icefall.jpg')} alt="" widths={[220, 440]} sizes="15vw" style="aspect-ratio: 9 / 16" class="loop__poster" />
          <span class="burn"><span class="tl">A012 C001</span><span class="bl">TC 15:40:27:03</span></span>
        </span>
        <span class="cap"><span class="name">The icefall</span><span class="verb">filmed and edited</span><span>08</span></span>
      </a>
      <a class="f at d-only" href="/near-mountains" style={at(300, 3640, 420, 1.2)}>
        <Picture image={day('best/lt_hat2.jpg')} alt="My orange hat with cartoon eyes, set down in front of the Langtang range." widths={[420, 840]} sizes="29vw" style="aspect-ratio: 4 / 3" />
        <span class="cap"><span class="name">The hat</span><span class="verb">it came all the way up</span><span>09</span></span>
      </a>
      <a class="f at pol d-only" href="/me" style={at(790, 3590, 250, -2.4)}>
        <Picture image={day('best/lt_selfie.jpg')} alt="Aditya at the top in Langtang: hat, orange glasses, face wrapped against the wind, prayer flags and peaks behind." widths={[260, 520]} sizes="17vw" style="aspect-ratio: 4 / 5; object-position: 50% 30%" />
        <span class="pc">me, Langtang</span>
      </a>
      <a class="f at d-only" href="/near-mountains" style={at(1080, 3650, 150, 2.2)}>
        <Picture image={day('c/shadow_hat.jpg')} alt="My shadow on the snow, wearing the hat." widths={[160, 320]} sizes="11vw" style="aspect-ratio: 3 / 4; object-position: 50% 80%" />
        <span class="cap"><span class="name">My shadow</span><span class="verb">and the hat</span></span>
      </a>
      <a class="card m-only" href="/near-mountains">
        <Picture image={day('best/v_icefall.jpg')} alt="An icefall in Langtang, from my footage." widths={[480, 540]} sizes="100vw" style="aspect-ratio: 4 / 5" />
        <span class="vf"></span>
        <span class="card__t"><b>Near Mountains.</b><small>{words.mountains}</small></span>
      </a>
    </section>

    <!-- 6. Golden hour: the page turns the colour of the water -->
    <section class="s6">
      <p class="slug slug--gold" style="--y:4066"><b>6</b><span>EXT. THE RIVER. GOLDEN HOUR.</span></p>
      <span class="low" aria-hidden="true"></span>
      <figure class="boat">
        <picture>
          <source media="(max-width: 899.98px)" srcset={(await getImage({ src: day('boat_sq.jpg'), format: 'webp', width: 780, quality: 72 })).src} />
          <img src={(await getImage({ src: day('boat.jpg'), format: 'webp', width: 1284, quality: 72 })).src} loading="lazy" decoding="async" width="1284" height="538" alt="Two people on a small boat, alone on gold water. A photograph by Aditya." />
        </picture>
      </figure>
      <span class="mtc mtc--gold m-only"><b>17:21</b><i>golden hour</i></span>
      <span class="mtc mtc--set m-only"><b>18:02</b><i>sunset</i></span>
      {settings.instagramPhotos && <a class="credit" href={settings.instagramPhotos} target="_blank" rel="noopener">A boat on gold water · @anorigix ↗</a>}
    </section>

    <!-- 7. After the sun went down -->
    <section class="s7">
      <Picture image={day('redsky.jpg')} alt="A red sky after sunset, huts in silhouette. A photograph by Aditya." widths={[800, 1100]} sizes="100vw" class="red d-only" />
      <p class="slug slug--ember" style="--y:4720"><b>7</b><span>EXT. THE SAME RIVER. LAST LIGHT.</span></p>
    </section>

    <!-- Night: the closing line. The seven services live in the booklet on the Me page. -->
    <section class="s-night">
      <p class="closing">{words.closing}</p>
      <div class="pill pill--night">
        <span class="pill__live">{words.status}</span>
        <a href="/me#work"><span class="clap" aria-hidden="true"><i></i></span>Work with me</a>
        <a class="pill__ghost" href="/contact">Contact me</a>
      </div>
      <div class="also">
        <small>Also playing</small>
        <a href="/everything">Everything</a>
        <a href="/museum">The museum</a>
        <a href="/writing/fireflies">Fireflies{[[-8, 10, 0], [30, -18, 0.6], [68, -6, 1.2], [104, 30, 1.8], [48, 96, 0.3]].map(([left, top, delay]) => <span class="ff" style={`left:${left}%;top:${top}%;animation-delay:${delay}s`}></span>)}</a>
        <a href="/me">Me</a>
      </div>
      <p class="sp fade-out">FADE OUT.</p>
      <Picture image={day('u/portrait-bw.jpg')} alt="" widths={[80]} sizes="22px" class="cameo d-only" />
    </section>
  </div>
</Base>

<script src="../scripts/hero.js"></script>
<script src="../scripts/loops.js"></script>

<style>
  /* Sizes are in "u": one u is one pixel of the 1440 wide design, so everything scales with the screen. */
  .day { position: relative; color: var(--ink); }
  .day a { text-decoration: none; }
  .sp { margin: 0; font: 400 15px/1.55 var(--font-script); color: #d8d4ca; }
  .opening span { display: block; }
  .title { margin: 0; font-weight: 600; letter-spacing: -0.05em; color: #f4efe6; }
  .statement { margin: 0; font: italic 400 36px/1.16 var(--font-serif); }
  .closing { margin: 0; font: italic 400 34px/1.2 var(--font-serif); color: var(--night-ink); }

  /* ----- Pictures on the board ----- */
  .f { display: block; margin: 0; color: var(--ink); transition: rotate 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), scale 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .f:hover, .f:focus-visible { rotate: 0deg; scale: 1.03; z-index: 5; }
  .f :global(img), .f video { display: block; width: 100%; height: auto; object-fit: cover; box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08), 0 18px 40px -24px rgba(0, 0, 0, 0.45); }
  .shot { position: relative; display: block; }
  .cap { display: flex; justify-content: space-between; gap: 12px; padding-top: 8px; font: 400 max(9px, calc(10 * var(--u))) / 1.3 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; }
  .cap .verb { display: none; color: var(--muted); }
  .f:hover .cap .verb, .f:focus-visible .cap .verb { display: inline; }
  .f:hover .cap .name, .f:focus-visible .cap .name { display: none; }
