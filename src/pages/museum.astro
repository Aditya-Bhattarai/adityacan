---
// THE MUSEUM (scene 10, night): nine of my photographs in film frames, chairs for the people I learn from, what else made me.
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { getSettings } from '../lib/content.js';
import { at, day } from '../lib/day.js';

const photos = getSettings().instagramPhotos;

// ---------- WORDS: change the text between the quotes and save ----------
const words = {
  title: 'I am a museum of everything I have loved.',
  room1: 'Nine of my photographs, framed the way I would frame a film. Hover one, or tap it, and the matte lifts.',
};
// Room 1. x and y place the frame, h is its height, bar is how tall the black matte is, top and bottom. pos moves the picture inside its frame.
const frames = [
  { img: 'boat_sq.jpg', name: 'A boat on gold water', ratio: '2.39 : 1', x: 50, y: 430, h: 414, bar: 119 },
  { img: 'best/window_bars_bw.jpg', name: 'Light through the bars', ratio: '1.85 : 1', x: 50, y: 924, h: 413, bar: 93 },
  { img: 'best/spiral.jpg', name: 'The spiral', ratio: '1.66 : 1', x: 50, y: 1417, h: 560, bar: 153 },
  { img: 'best/ktm_colonial_bw.jpg', name: 'White columns, black sky', ratio: '1.66 : 1', x: 510, y: 430, h: 560, bar: 153 },
  { img: 'best/phewa.jpg', name: 'Phewa, before the rain', ratio: '2.39 : 1', x: 510, y: 1070, h: 315, bar: 70 },
  { img: 'best/clouds_gold_hills.jpg', name: 'Light breaking over the hills', ratio: '2.39 : 1', x: 510, y: 1465, h: 560, bar: 192 },
  { img: 'moon.jpg', name: 'The moon, close', ratio: '2.39 : 1', x: 970, y: 430, h: 416, bar: 120 },
  { img: 'best/rain_car_bw.jpg', name: 'Monsoon on the window', ratio: '1.85 : 1', x: 970, y: 926, h: 472, bar: 122 },
  { img: 'best/ktm_facade_bw.jpg', name: 'A face in the window', ratio: '1.85 : 1', x: 970, y: 1477, h: 560, bar: 166, pos: '50% 64%' },
];
// Room 2. A few chairs on set kept for the people I learn from. Name, then the film of theirs I return to.
const chairs = [
  ['Kiarostami', 'Where Is the Friend’s House?', '1987'],
  ['Satyajit Ray', 'Pather Panchali', '1955'],
  ['Ozu', 'Tokyo Story', '1953'],
  ['Wenders', 'Perfect Days', '2023'],
];
// Room 3. The phone flips through covers I made. "fit" shows a wide YouTube cover with black above and below.
const covers = [
  ['u/ph-fonepay-mac.jpg'], ['u/ph-gold.jpg', 'fit'], ['u/ph-fonepay-rules.jpg'], ['u/ph-coffee.jpg'], ['u/ph-engine.jpg'], ['u/ph-nada.jpg'],
];
// Room 3. The toolkit, as keys. "wide" keys carry a whole word.
const keys = [
  ['Pr', 'Premiere Pro'], ['Ae', 'After Effects'], ['Resolve', 'DaVinci', 'w'], ['Ps', 'Photoshop'], ['Ai', 'Illustrator'],
  ['CapCut', '', 'w'], ['Canva', '', 'w'], ['Notion', '', 'w'], ['BM Cam', 'Blackmagic Camera', 'w'], ['Lr', 'Lightroom'],
  ['Au', 'Audition'], ['Claude', '', 'w'], ['J', 'reverse', 'j'], ['K', 'pause', 'j'], ['L', 'play', 'l'],
];
const quotes = [
  { text: '“I think if people died and then came back to life, they’d appreciate life more.”', by: 'AND LIFE GOES ON · ABBAS KIAROSTAMI, 1992', pos: at(80, 3565, 400, 1.8) },
  { text: '“The most personal is the most creative.”', by: 'MARTIN SCORSESE · QUOTED BY BONG JOON HO, 2020', pos: at(860, 3945, 420, -1.4) },
];
---

<Base
  title="The museum"
  description="Nine of Aditya Bhattarai’s photographs in film frames, the filmmakers and creators he learns from, and what else made him."
  current="museum" theme="dark" scene="10" slug="INT. MUSEUM. NIGHT." sky="#1B1A18" grain
>
  <div class="mus">
    <span class="spots d-only" aria-hidden="true"></span>
    <h1 class="at" style={at(28, 92, 940)}>{words.title}</h1>
    <p class="mono by">Unknown artist</p>
    <svg class="cam d-only" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
      <g stroke="#ECEBE6" stroke-opacity=".32" fill="none" stroke-width="1.2" stroke-dasharray="3 7"><path d="M1352 176 L1180 300"></path><path d="M1352 176 L1300 330"></path></g>
      <rect x="1342" y="160" width="26" height="18" transform="rotate(30 1355 169)" stroke="#ECEBE6" stroke-opacity=".7" fill="none" stroke-width="1.5"></rect>
      <text x="1310" y="150" fill="#ECEBE6" fill-opacity=".55" font-family="JetBrains Mono" font-size="9" letter-spacing="2">A CAM</text>
    </svg>

    <!-- Room 1. My frames -->
    <section class="room1">
      <p class="mono lab" style="--y:322">Room 1 · My frames</p>
      <p class="lead at" style={at(50, 346, 820)}>{words.room1}</p>
      <div class="frames">
        {frames.map((frame, index) => (
          <figure class="mf at" style={`${at(frame.x, frame.y, 420)};--h:${frame.h};--b:${frame.bar}`}>
            <div class="fr" tabindex="0">
              <Picture image={day(frame.img)} alt={`${frame.name}. A photograph by Aditya.`} widths={[420, 840]} sizes="(max-width: 900px) 50vw, 30vw" eager={[0, 1, 3, 6].includes(index)} style={frame.pos && `object-position:${frame.pos}`} />
              <span class="bar t"></span>
              <span class="bar b"><span class="n">{String(index + 1).padStart(2, '0')}</span><span class="rt">{frame.ratio}</span></span>
            </div>
            <figcaption><span>{frame.name}</span>{photos && <a href={photos} target="_blank" rel="noopener">@anorigix ↗</a>}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Room 2. The people I learn from: their chairs on set -->
    <section class="crl">
      <p class="mono">Room 2 · The people I learn from · their chairs stay on my set</p>
      <ul class="chairs">
        {chairs.map(([name, film, year], index) => (
          <li class="chair" style={`--tilt:${[-1.5, 1, -0.5, 1.8][index]}deg`}>
            <div class="chair__art">
              <svg viewBox="0 0 200 230" aria-hidden="true">
                <g class="wood"><path d="M30 6 V150 M170 6 V150"></path><path d="M14 104 H186"></path><path d="M34 150 L166 224 M166 150 L34 224"></path><path d="M22 224 H62 M138 224 H178"></path></g>
                <rect class="seat" x="30" y="136" width="140" height="14"></rect>
              </svg>
              <span class="chair__back">{name}</span>
            </div>
            <p><i>{film}</i><span>{year}</span></p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Room 3. What else made me -->
    <section class="room3">
      <p class="mono lab" style="--y:2955">Room 3 · What else made me</p>

      <div class="keys at" style={at(60, 3035, 540, -0.8)}>
        {keys.map(([big, small, kind]) => <div class:list={['key', kind]}><b>{big}</b><small>{small}</small></div>)}
      </div>
      <div class="plq at d-only" style={at(64, 3355, 236)}><b>Toolkit</b><span>What I use</span></div>

      <div class="pin crows at" tabindex="0" style={at(690, 3030, 430, -2)}>
        <span class="tape d-only"></span>
        <span class="ng" style="top: 7px"></span>
        <Picture image={day('c/birds_lamp.jpg')} alt="Seven dark birds sitting on a street lamp against the sky. My photograph. Point at it and it turns to a negative: the birds go white." widths={[430, 860]} sizes="(max-width: 900px) 100vw, 30vw" />
        <span class="ng" style="bottom: 7px"></span>
        <span class="ed" style="left: 14px">→ 12A</span><span class="ed" style="right: 14px"><em>Positive</em><em>Negative</em></span>
      </div>
      <div class="plq at" style={at(700, 3424, 236)}><b>Crows Are White</b><span>The documentary that moved me most · my birds, point at them</span></div>

      <div class="pin phone at d-only" style={at(1222, 3015, 196, 3)} aria-hidden="true">
        <div class="reel">
          {covers.map(([img, fit], index) => <Picture image={day(img)} alt="" widths={fit ? [400, 800] : [200, 400]} sizes="196px" class={fit ? 'fit' : undefined} style={`animation-delay:${(index - covers.length) * 1.2}s`} />)}
        </div>
      </div>
      <div class="plq at d-only" style={at(1200, 3455, 220)}><b>Covers I made</b><span>Fonepay, Siddhartha, Satik Kura</span></div>

      {quotes.map((quote) => <blockquote class="quote at" style={quote.pos}><p>{quote.text}</p><cite>{quote.by}</cite></blockquote>)}

      <div class="pin jr at" style={at(600, 3535, 620, -1.2)}>
        <div class="jr__l"><figure class="jr__ph"><Picture image={day('c/horse_rdr.jpg')} alt="A pack horse with a worn saddle on a dry mountain trail, graded warm and faded like an old western. My photograph." widths={[300, 600]} sizes="(max-width: 900px) 80vw, 21vw" /></figure></div>
        <div class="jr__r"><small>Langtang, May</small><span>It taught me men are afraid too.</span></div>
      </div>
      <div class="plq at" style={at(1236, 3565, 180)}><b>Red Dead Redemption 2</b><i>Rockstar Games, 2018</i><span>My photo of a horse on the trail, in its colours</span></div>

      <figure class="pin snow at" style={at(70, 3740, 200, 1.6)}>
        <Picture image={day('c/figure_field.jpg')} alt="One small figure with open arms in a wide field under a big sky. My photograph." widths={[200, 400]} sizes="(max-width: 900px) 60vw, 14vw" style="aspect-ratio: 4 / 5" />
      </figure>
      <div class="plq at" style={at(290, 3930, 236)}><b>One small figure, a lot of land</b><span>After Kiarostami · my photograph</span></div>

      <!-- The floor: Sapana, every frame in order -->
      <div class="floor">
        <div class="strip"><Picture image={day('u/sapana-barcode.png')} alt="Every frame of Sapana squeezed into one strip of colour." widths={[720, 1440]} sizes="92vw" /><i class="phd"></i></div>
        <p class="mono">Every frame of <span class="dv" lang="ne">सपना</span>, in order</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .mus { position: relative; color: var(--night-ink); }
  .mus a { color: inherit; }
  .mono { margin: 0; font: 400 10px/1.5 var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--night-muted); }
  h1 { margin: 0; font: italic 400 76px/0.98 var(--font-serif); letter-spacing: -0.015em; }
  .lead { margin: 0; font: 400 30px/1.15 var(--font-serif); }

  .mf { margin: 0; }
  .fr { position: relative; overflow: hidden; background: #000; outline: none; box-shadow: 0 30px 60px -28px rgba(0, 0, 0, 0.9); }
  .fr > :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .bar { position: absolute; left: 0; right: 0; background: #050505; transition: height 0.8s cubic-bezier(0.7, 0, 0.2, 1); z-index: 1; overflow: hidden; }
  .bar.t { top: 0; } .bar.b { bottom: 0; }
  .fr:hover .bar, .fr:focus .bar { height: 0; }
  .n, .rt { position: absolute; bottom: 8px; font: 400 9px/1 var(--font-mono); letter-spacing: 0.2em; color: var(--night-muted); text-transform: uppercase; white-space: nowrap; }
  .n { left: 11px; } .rt { right: 11px; }
  .mf figcaption { display: flex; justify-content: space-between; gap: 12px; padding-top: 12px; font: 400 9.5px/1.4 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--night-muted); }
  .mf figcaption span { color: var(--night-ink); }
  .mf figcaption a { text-decoration: none; }
  .mf figcaption a:hover { color: var(--night-ink); }

  .crl .mono { padding-bottom: 22px; }
  .chairs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .chair { rotate: var(--tilt); transition: rotate 0.6s cubic-bezier(0.3, 0.6, 0.2, 1), translate 0.6s cubic-bezier(0.3, 0.6, 0.2, 1); }
  .chair:hover { rotate: 0deg; translate: 0 -6px; }
  .chair__art { position: relative; }
  .chair svg { display: block; width: 100%; height: auto; overflow: visible; }
  .wood { fill: none; stroke: #8a6a48; stroke-width: 7; stroke-linecap: round; }
  .seat { fill: #0b0b0a; stroke: #5a4632; stroke-width: 2; }
  .chair__back { position: absolute; left: 11%; right: 11%; top: 4.5%; height: 22%; display: flex; align-items: center; justify-content: center; background: #0b0b0a; border: 1px solid #3a3530; box-shadow: 0 8px 16px -10px rgba(0, 0, 0, 0.9); font: 600 clamp(12px, 1.5vw, 22px)/1 var(--font-sans); letter-spacing: 0.06em; text-transform: uppercase; color: var(--night-ink); white-space: nowrap; transition: color 0.4s; }
  .chair:hover .chair__back { color: var(--gold); }
  .chair p { margin: 18px 0 0; display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
  .chair p i { font: 400 21px/1.15 var(--font-serif); }
  .chair p span { font: 400 9.5px/1.4 var(--font-mono); letter-spacing: 0.18em; color: var(--night-muted); }

  .pin { box-shadow: 0 30px 60px -28px rgba(0, 0, 0, 0.9); }
  .plq { background: #f4f3ee; color: var(--ink); padding: 11px 13px 13px; display: flex; flex-direction: column; gap: 3px; box-shadow: 0 10px 20px -12px rgba(0, 0, 0, 0.8); }
  .plq b { font-size: 13px; font-weight: 600; letter-spacing: -0.01em; }
  .plq i { font: 400 16px/1.15 var(--font-serif); }
  .plq span { font: 400 8.5px/1.5 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); padding-top: 3px; }
  .keys { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .key { position: relative; height: 86px; border-radius: 12px; background: var(--night-ink); color: var(--ink); box-shadow: 0 6px 0 #8f8e88, 0 14px 24px -8px rgba(0, 0, 0, 0.8); display: flex; flex-direction: column; justify-content: space-between; padding: 10px 12px; transition: transform 0.08s, box-shadow 0.08s; user-select: none; }
  .key:active { transform: translateY(5px); box-shadow: 0 1px 0 #8f8e88, 0 6px 12px -6px rgba(0, 0, 0, 0.8); }
  .key b { font-size: 28px; font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .key small { font: 400 8px/1.2 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .key.w b { font-size: 17px; letter-spacing: -0.02em; }
  .key.j { background: #e4e1d8; } .key.l { background: #f1dda4; }
  .crows { position: relative; background: #0c0c0b; padding: 26px 14px; outline: none; }
  .tape { position: absolute; width: 90px; height: 24px; background: rgba(236, 228, 205, 0.72); top: -12px; left: 70%; margin-left: -45px; rotate: -3deg; z-index: 2; }
  .ng { position: absolute; left: 12px; right: 12px; height: 11px; background-image: repeating-linear-gradient(90deg, transparent 0 9px, #34342f 9px 20px, transparent 20px 29px); background-size: 29px 7px; background-repeat: repeat-x; background-position: 0 2px; }
  .crows :global(img) { display: block; width: 100%; height: auto; filter: grayscale(1) contrast(1.2) brightness(1.05); transition: filter 1s ease; }
  .crows:hover :global(img), .crows:focus :global(img) { filter: grayscale(1) contrast(1.2) brightness(1.05) invert(1); }
  .ed { position: absolute; bottom: -16px; font: 400 8px/1 var(--font-mono); letter-spacing: 0.2em; color: var(--gold); text-transform: uppercase; }
  .ed em { font-style: normal; } .ed em + em { display: none; }
  .crows:hover .ed em, .crows:focus .ed em { display: none; } .crows:hover .ed em + em, .crows:focus .ed em + em { display: inline; }
  .quote { margin: 0; background: #fbf8f0; color: #3a3835; padding: 22px 26px; box-shadow: 0 24px 50px -26px rgba(0, 0, 0, 0.9); }
  .quote p { margin: 0; font: 500 30px/1.15 var(--font-hand); }
  .quote cite { display: block; padding-top: 12px; font: normal 400 9px/1.4 var(--font-mono); letter-spacing: 0.16em; color: #7a776f; }
  .jr { background: #2a1b11; background-image: radial-gradient(120% 90% at 30% 20%, #4a3020, #2a1b11 70%); border-radius: 8px; padding: 12px; display: flex; box-shadow: inset 0 0 0 2px #1a100a, inset 0 0 0 5px rgba(201, 160, 110, 0.18), 0 30px 60px -28px rgba(0, 0, 0, 0.9); transition: rotate 0.8s cubic-bezier(0.3, 0.6, 0.2, 1), scale 0.8s; }
  .jr:hover { rotate: 0deg; scale: 1.02; }
  .jr__l, .jr__r { flex: 1; background-color: #e7dcc0; background-image: radial-gradient(40% 30% at 78% 82%, rgba(140, 95, 45, 0.22), transparent 70%), radial-gradient(30% 22% at 16% 14%, rgba(140, 95, 45, 0.16), transparent 70%), radial-gradient(120% 120% at 50% 50%, transparent 60%, rgba(120, 80, 40, 0.28)); }
  .jr__l { box-shadow: inset -18px 0 22px -14px rgba(60, 35, 15, 0.45); padding: 18px; display: flex; align-items: center; justify-content: center; }
  .jr__ph { position: relative; box-sizing: border-box; margin: 0; width: 100%; height: 100%; padding: 6px 6px 18px; background: #f3ead2; rotate: -2.5deg; box-shadow: 0 6px 12px -6px rgba(40, 25, 10, 0.6); }
  .jr__ph::before, .jr__ph::after { content: ''; position: absolute; width: 22px; height: 22px; border: solid #3a2618; border-width: 0; }
  .jr__ph::before { top: -3px; left: -3px; border-top-width: 6px; border-left-width: 6px; }
  .jr__ph::after { bottom: -3px; right: -3px; border-bottom-width: 6px; border-right-width: 6px; }
  .jr__ph :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; filter: sepia(0.18) contrast(1.04); }
  .jr__r { position: relative; box-shadow: inset 18px 0 22px -14px rgba(60, 35, 15, 0.45); padding: 24px 22px; font: 500 26px/30px var(--font-hand); color: #3a2618; display: flex; flex-direction: column; justify-content: center; gap: 10px; }
  .jr__r small { font: 400 9px/1.4 var(--font-mono); letter-spacing: 0.2em; text-transform: uppercase; color: #6e5034; }
  .snow { margin: 0; background: #f4f1e8; padding: 8px 8px 10px; }
  .snow :global(img) { display: block; width: 100%; height: auto; object-fit: cover; }
  .floor { display: flex; flex-direction: column; gap: 10px; }
  .strip { position: relative; }
  .strip :global(img) { display: block; width: 100%; height: 44px; object-fit: fill; filter: brightness(0.78); transition: filter 0.6s; }
  .strip:hover :global(img) { filter: none; }
  .phd { position: absolute; top: -6px; bottom: -6px; left: 0; width: 2px; background: var(--night-ink); opacity: 0; pointer-events: none; }
  .strip:hover .phd { opacity: 1; animation: runph 14s linear infinite; }
  @keyframes runph { to { left: calc(100% - 2px); } }
  .floor .dv { font-size: 13px; letter-spacing: 0; text-transform: none; color: var(--night-ink); }

  @media (min-width: 900px) {
    .mus { height: calc(4255 * var(--u)); overflow: hidden; }
    .mus > section { display: contents; }
    .frames { display: contents; }
    .spots { position: absolute; left: 0; right: 0; top: 0; height: calc(1000 * var(--u)); pointer-events: none; background: radial-gradient(32% 62% at 18% 36%, rgba(255, 232, 190, 0.17), rgba(255, 232, 190, 0) 72%), radial-gradient(32% 62% at 50% 36%, rgba(255, 232, 190, 0.17), rgba(255, 232, 190, 0) 72%), radial-gradient(32% 62% at 82% 36%, rgba(255, 232, 190, 0.17), rgba(255, 232, 190, 0) 72%); }
    h1 { top: max(96px, calc(92 * var(--u))); font-size: calc(76 * var(--u)); }
    .by { position: absolute; left: 32px; top: calc(max(96px, 92 * var(--u)) + 172 * var(--u)); }
    .cam { position: absolute; left: 0; top: 0; width: 100%; height: calc(400 * var(--u)); pointer-events: none; }
    .lab { position: absolute; left: calc(50 * var(--u)); top: calc(var(--y) * var(--u)); }
    .lead { font-size: max(18px, calc(30 * var(--u))); }
    .fr { height: calc(var(--h) * var(--u)); }
    .bar { height: calc(var(--b) * var(--u)); }
    .crl { position: absolute; display: block !important; left: calc(50 * var(--u)); right: calc(50 * var(--u)); top: calc(2187 * var(--u)); }
    .chairs { gap: calc(70 * var(--u)); padding: calc(10 * var(--u)) calc(60 * var(--u)) 0; }
    .chair p i { font-size: max(15px, calc(22 * var(--u))); }
    .plq { position: absolute; }
    .keys { gap: calc(14 * var(--u)); }
    .key { height: calc(86 * var(--u)); border-radius: calc(12 * var(--u)); padding: calc(10 * var(--u)) calc(12 * var(--u)); }
    .key b { font-size: calc(28 * var(--u)); }
    .key.w b { font-size: calc(17 * var(--u)); }
    .key small { font-size: max(6px, calc(8 * var(--u))); }
    .crows { position: absolute; padding: calc(26 * var(--u)) calc(14 * var(--u)); }
    .phone { height: calc(400 * var(--u)); background: #0a0a09; border-radius: calc(26 * var(--u)); padding: calc(10 * var(--u)); }
    .reel { position: relative; width: 100%; height: 100%; border-radius: calc(18 * var(--u)); overflow: hidden; background: #000; }
    .reel :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: cut 2s steps(1) infinite; }
    .reel :global(img.fit) { object-fit: contain; }
    .reel :global(img) { animation-duration: 7.2s; }
    @keyframes cut { 0%, 16.6% { opacity: 1; } 16.7%, 100% { opacity: 0; } }
    .quote p { font-size: max(18px, calc(30 * var(--u))); }
    .jr { height: calc(360 * var(--u)); }
    .jr__r { font-size: max(18px, calc(30 * var(--u))); line-height: 1.15; }
    .floor { position: absolute; left: calc(60 * var(--u)); right: calc(60 * var(--u)); top: calc(4155 * var(--u)); }
  }
  @media (prefers-reduced-motion: reduce) { .reel :global(img:first-child) { opacity: 1 !important; } }

  @media (max-width: 899.98px) {
    .mus { padding: 112px 22px 44px; display: flex; flex-direction: column; gap: 14px; }
    .mus > section { display: flex; flex-direction: column; gap: 18px; padding-top: 22px; }
    h1 { font-size: 34px; line-height: 1.02; }
    .lab { opacity: 0.9; }
    .mono { font-size: 12px; letter-spacing: 0.1em; }
    .plq span { font-size: 12px; letter-spacing: 0.06em; }
    .quote cite { font-size: 12px; letter-spacing: 0.08em; }
    .lead { font-size: 20px; }
