---
// ME, then WORK WITH ME, on one page.
// Top half (scene 8, before sunrise): who I am, a pause, the darkroom contact sheet of my life.
// Bottom half (scene 8B, golden hour, at #work): the booklet. What I do, how it goes, ways to work, questions.
// There are no prices anywhere. Every "Contact me" button opens the Contact page.
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { getSettings } from '../lib/content.js';
import { day } from '../lib/day.js';

const settings = getSettings();

// ---------- WORDS: change the text between the quotes and save ----------
const me = {
  hello: 'Hi, I’m Aditya.',
  helloNepali: 'नमस्ते, म आदित्य हुँ।',
  who: 'A filmmaker and content strategist from the Kathmandu Valley, Nepal.',
  more: 'First year of film school. Making things for the internet since I was about ten. It started with small funny bits.',
};
// The contact sheet: twelve frames of a life, in order. "focus" is which part of the photo shows.
const frames = [
  ['c/elders_bw.jpg', 'A studio portrait from long before me, hand tinted grey.', '50% 22%'],
  ['c/baby.jpg', 'Me as a baby in red, held up in a garden.', '50% 40%'],
  ['c/toddler.jpg', 'Me, very small, in a striped sweater and a paper crown.', '50% 30%'],
  ['c/kid_point.jpg', 'Me as a schoolboy, pointing straight at the camera.', '50% 35%'],
  ['c/kid_lake.jpg', 'Me as a boy, leaning on a railing by a lake.', '50% 40%'],
  ['c/desk.jpg', 'My desk: the rope lamp, the screen, the hat on the computer.', '50% 60%'],
  ['c/walkie.jpg', 'A walkie talkie in my hand on a forest set.', '50% 50%'],
  ['u/ptp-present.jpg', 'On stage at the festival.', '50% 50%'],
  ['u/hero-poster.jpg', 'Talking to camera.', '50% 30%'],
  ['c/bts_set.jpg', 'A podcast set seen from behind the cameras.', '50% 62%'],
  ['c/shadow_hat.jpg', 'My shadow on the snow, hat and all.', '50% 86%'],
  ['c/now.jpg', 'Me now, on the phone in a lift.', '50% 24%'],
];

const book = {
  intro: 'Open the booklet: what I do, how it usually goes, the ways we can work together, and the questions people ask first. No prices, just a call.',
  promise: 'I plan what you should make, make it, see how it did, and use that to make the next one better.',
  // The seven services. They appear only here.
  services: [
    ['Content strategy and audits', 'audit · written plan · content calendar'],
    ['Long form editing', 'youtube · podcasts · interviews'],
    ['Reels and shorts', 'reels · shorts · repurposing'],
    ['Thumbnails and covers', 'youtube thumbnails · vertical covers'],
    ['Motion graphics', 'charts · lower thirds · titles'],
    ['Direction and production', 'brand films · scripts · on set'],
    ['Film and documentary editing', 'documentary · short film · colour'],
  ],
  steps: [
    ['Week 1', 'Audit', 'I go through your channels and numbers and tell you honestly what’s working.'],
    ['Week 1', 'Strategy', 'We decide what you want to be known for, which formats to make and when they go out.'],
    ['Week 2', 'Preproduction', 'Scripts, hooks and shot lists, all sorted before the shoot.'],
    ['Ongoing', 'Shoot and edit', 'The long version first, then every short you can cut from it.'],
    ['Ongoing', 'Package', 'Titles, thumbnails, covers and captions, ready to post.'],
    ['Monthly', 'Review', 'We look at the numbers together and change what the next batch needs.'],
  ],
  ways: [
    ['ONE PROJECT', 'A single project', 'One film, one campaign or one channel audit, with a clear start and end.', '#F4E6C9', 0],
    ['ONGOING', 'Monthly content partner', 'Strategy, editing and thumbnails every month, like having someone in house.', '#E3D6E6', 1.2],
    ['FILM', 'Film and production', 'Brand films, documentaries and short films. I can direct, produce, edit or do all three.', '#D5E0E6', 0],
  ],
  questions: [
    ['Do you work with clients outside Nepal?', 'Yes. I’m in Kathmandu and we’d work together online.'],
    ['Can you work with footage I’ve already shot?', 'Yes. Send me what you have and I’ll tell you honestly what it can become.'],
    ['Can we start with one video?', 'Yes. Most people start with a single project and keep going if it works for them.'],
    ['What languages do you work in?', 'English, Hindi and Nepali.'],
  ],
};
const steam = 'M6 40 C 0 30, 12 22, 6 12 C 2 6, 8 3, 6 0';
---

<Base
  title="Me, and how I work"
  description="Aditya Bhattarai is a filmmaker and content strategist from the Kathmandu Valley, Nepal. Who he is, what he does, how working together goes, and how to book a call."
  current="about" scene="8" slug="INT. DARKROOM. BEFORE SUNRISE." grain
  sky="linear-gradient(180deg, #F2D7C2 0px, #F3E6D8 230px, #F1F0EC 580px)"
>
  <!-- ============ ME ============ -->
  <section class="hello">
    <div class="kmr" tabindex="0">
      <Picture image={day('u/portrait-bw.jpg')} alt="Aditya, black and white, natural light." widths={[420, 560, 760, 1120]} sizes="(max-width: 900px) 100vw, 40vw" eager />
      <span class="kleaf" aria-hidden="true"></span>
      <span class="kw" aria-hidden="true">komorebi</span>
    </div>
    <div class="hello__text">
      <h1 class="hi"><span class="en">{me.hello}</span><span class="ne" lang="ne" aria-hidden="true">{me.helloNepali}</span></h1>
      <p class="who">{me.who}</p>
      <p class="more">{me.more}</p>
      <div class="hello__row">
        <a class="btn" href="/contact">Contact me</a>
        {settings.whatsappHref && <a class="btn btn--line" href={settings.whatsappHref} target="_blank" rel="noopener">Message me on WhatsApp</a>}
        <a class="down" href="#work">How I work <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <!-- A pillow shot: a still place between scenes. Nothing happens here, on purpose. -->
  <figure class="ozu" tabindex="0">
    <div class="still"><Picture image={day('lake.jpg')} alt="A lake under a heavy sky, small boats far out." widths={[640, 1000]} sizes="(max-width: 900px) 100vw, 640px" /></div>
    <figcaption><span>a pause</span><span>after Ozu</span></figcaption>
  </figure>

  <!-- The contact sheet of a life -->
  <section class="cs">
    <span class="safelight" aria-hidden="true"></span>
    <p class="cs__label m-only">The contact sheet · twelve frames, in order</p>
    <div class="cs__in">
      {[frames.slice(0, 6), frames.slice(6)].map((row, rowIndex) => (
        <div class="strip">
          <div class="sprk"></div>
          <div class="strip__row">
            {row.map(([img, alt, focus], index) => (
              <div class="fr" tabindex="0">
                <Picture image={day(img)} alt={alt} widths={[240, 480]} sizes="(max-width: 900px) 33vw, 15vw" style={`object-position:${focus}`} />
                <span class="n">{rowIndex * 6 + index + 1}</span>
              </div>
            ))}
          </div>
          <div class="sprk"></div>
          {rowIndex === 1 && (
            <>
              <svg class="grease d-only" width="260" height="170" viewBox="0 0 260 170" aria-hidden="true"><path d="M30 92 C 24 30, 150 8, 226 40 C 268 62, 240 140, 150 152 C 70 162, 20 132, 36 80" fill="none" stroke="#E8B23A" stroke-width="5" stroke-linecap="round" class="gp" pathLength="1"></path></svg>
              <span class="thisone d-only" aria-hidden="true">this one</span>
            </>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- A door to the strange room -->
  <div class="door-row">
    <Picture image={day('u/portrait-bw.jpg')} alt="" widths={[80]} sizes="22px" class="cameo d-only" />
    <a class="door" href="/museum"><span>The museum</span><i aria-hidden="true">→</i></a>
  </div>

  <!-- ============ WORK WITH ME ============ -->
  <div class="cutto" aria-hidden="true"><span>CUT TO:</span></div>
  <div class="desk" id="work">
    <input type="radio" name="pg" id="p0" checked aria-label="Booklet cover" />
    <input type="radio" name="pg" id="p1" aria-label="Booklet pages 1 and 2: what I do" />
    <input type="radio" name="pg" id="p2" aria-label="Booklet pages 3 and 4: how it usually goes" />
    <input type="radio" name="pg" id="p3" aria-label="Booklet pages 5 and 6: ways to work together, and questions" />
    <input type="radio" name="pg" id="p4" aria-label="Booklet back cover" />

    <p class="slug8b"><b>8B</b><span>INT. DESK. GOLDEN HOUR. LATER THAT DAY.</span></p>
    <div class="howi">
      <h2>How I work.</h2>
      <p class="bk-only">{book.intro}</p>
      <a class="btn bk-only" href="/contact">Contact me</a>
    </div>
    <span class="blinds bk-only" aria-hidden="true">{[1, 2, 3, 4, 5, 6].map(() => <i></i>)}</span>

    <!-- The booklet (wider screens) -->
    <div class="book bk-only">
      <div class="sp s0">
        <div class="pg pg--cover">
          <span class="bk-mono">No. 01</span>
          <Picture image={day('c/walkie.jpg')} alt="A walkie talkie in my hand on set, the crew waiting." widths={[250, 500]} sizes="250px" />
          <div class="cover__t"><span>Working with me</span><span class="bk-mono">{settings.name}</span></div>
          <label class="curl curl--dark" for="p1" title="Open"></label>
        </div>
      </div>
      <div class="sp s1">
        <div class="pg l pg--spread">
          <h3 class="huge">What<br />I do.</h3>
          <p class="promise">{book.promise}</p>
          <label class="back" for="p0" title="Back"></label><span class="folio folio--l">1</span>
        </div>
        <div class="pg r" style="padding-top: 5%">
          {book.services.map(([name, tags]) => <div class="svc"><b>{name}</b><span class="bk-mono">{tags}</span></div>)}
          <label class="curl" for="p2" title="Next"></label><span class="folio folio--r">2</span>
        </div>
      </div>
      <div class="sp s2">
        <div class="pg l">
          <h3 class="mid">How it usually goes.</h3>
          {book.steps.slice(0, 3).map(([when, name, text]) => <div class="step"><span class="bk-mono">{when}</span><div><b>{name}</b><i>{text}</i></div></div>)}
          <label class="back" for="p1" title="Back"></label><span class="folio folio--l">3</span>
        </div>
        <div class="pg r" style="padding-top: 16.3%">
          {book.steps.slice(3).map(([when, name, text]) => <div class="step"><span class="bk-mono">{when}</span><div><b>{name}</b><i>{text}</i></div></div>)}
          <label class="curl" for="p3" title="Next"></label><span class="folio folio--r">4</span>
        </div>
      </div>
      <div class="sp s3">
        <div class="pg l">
          <h3 class="small">Ways to work together</h3>
          {book.ways.map(([stub, name, text, colour, tilt]) => (
            <div class="tix" style={`background:${colour};rotate:${tilt}deg`}><div class="stub"><span>{stub}</span></div><div class="tix__t"><b>{name}</b><span>{text}</span></div></div>
          ))}
          <label class="back" for="p2" title="Back"></label><span class="folio folio--l">5</span>
        </div>
        <div class="pg r" style="padding-top: 5.6%">
          {book.questions.map(([question, answer]) => <div class="q"><b>{question}</b><span>{answer}</span></div>)}
          <label class="curl" for="p4" title="Next"></label><span class="folio folio--r">6</span>
        </div>
      </div>
      <div class="sp s4">
        <div class="pg pg--back">
          <span class="chiya dv" lang="ne">चिया?{['a', 'b', 'c'].map((name) => <i class={`st ${name}`} aria-hidden="true"><svg viewBox="0 0 12 40" width="12" height="40"><path d={steam} fill="none" stroke="#8A8984" stroke-width="2" stroke-linecap="round"></path></svg></i>)}</span>
          <a class="btn" href="/contact">Contact me</a>
          <span class="bk-mono">30 min · Google Meet</span>
          <label class="back" for="p3" title="Back"></label>
        </div>
      </div>
    </div>
    <div class="tabs bk-only">
      <label for="p0">COVER</label><label for="p1">01</label><label for="p2">02</label><label for="p3">03</label><label for="p4">BACK</label>
    </div>

    <!-- The same pages, laid out for phones and small screens -->
    <div class="flow fl-only">
      <div class="paper">
        <h3>What I do.</h3>
        {book.services.map(([name]) => <div>{name}</div>)}
      </div>
      <p class="flow__s">{book.promise}</p>
      <h3>How it usually goes.</h3>
      {book.steps.map(([when, name, text]) => <div class="row"><small>{when}</small><b>{name}</b><span>{text}</span></div>)}
      <h3>Ways to work together</h3>
      {book.ways.map(([stub, name, text]) => <div class="row"><small>{stub}</small><b>{name}</b><span>{text}</span></div>)}
      <h3>Questions</h3>
      {book.questions.map(([question, answer]) => <div class="row"><b>{question}</b><span>{answer}</span></div>)}
      <h3 class="dv" lang="ne">चिया?</h3>
      <a class="btn" href="/contact">Contact me</a>
      <p class="flow__l">30 min · Google Meet</p>
    </div>
  </div>
</Base>

<style>
  .btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; border-radius: 999px; background: var(--ink); color: var(--paper); text-decoration: none; font-size: 15px; font-weight: 500; }
  .btn--line { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
  .down { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 6px; font: 400 12px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: inherit; text-decoration: none; }
  .down span { display: inline-block; transition: transform 0.3s; }
  .down:hover span { transform: translateY(4px); }

  /* ----- Me ----- */
  .hello { position: relative; display: flex; flex-wrap: wrap; gap: 64px; align-items: center; padding: 104px 28px 110px; }
  .kmr { position: relative; overflow: hidden; flex: 0 1 560px; min-width: 280px; outline: none; }
  .kmr :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .kmr:hover .kleaf, .kmr:focus-visible .kleaf { background-image: url('../assets/day/branches_shadow.jpg'); }
  .kleaf { position: absolute; inset: -14%; background: center / cover; mix-blend-mode: multiply; opacity: 0; transition: opacity 1.8s ease; pointer-events: none; transform-origin: 30% 0; }
  .kmr:hover .kleaf, .kmr:focus-visible .kleaf { opacity: 0.6; animation: sway 7s ease-in-out infinite alternate; }
  @keyframes sway { 0% { transform: rotate(-1.2deg) translate(-1%, 0); } 50% { transform: rotate(0.6deg) translate(1.5%, 1%); } 100% { transform: rotate(1.4deg) translate(-0.5%, -1%); } }
  .kw { position: absolute; left: 16px; bottom: 14px; font: 400 10px/1 var(--font-mono); letter-spacing: 0.18em; color: var(--paper); text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6); opacity: 0; transition: opacity 1s 1s; }
  .kmr:hover .kw, .kmr:focus-visible .kw { opacity: 1; }
  .hello__text { flex: 1 1 420px; display: flex; flex-direction: column; gap: 26px; max-width: 640px; }
  .hi { margin: 0; display: grid; font-weight: 600; font-size: clamp(50px, 8vw, 120px); line-height: 0.9; letter-spacing: -0.05em; }
  .hi span { grid-area: 1 / 1; align-self: end; transition: opacity 0.5s ease, transform 0.5s ease; }
  .hi .ne { opacity: 0; transform: translateY(10px); font: 400 0.6em/1.2 var(--font-devanagari); letter-spacing: 0; }
  .hi:hover .en { opacity: 0; transform: translateY(-10px); }
  .hi:hover .ne { opacity: 1; transform: none; }
  .who { margin: 0; font: 400 clamp(23px, 2.5vw, 36px) / 1.15 var(--font-serif); }
  .more { margin: 0; font-size: clamp(15px, 1.25vw, 18px); line-height: 1.5; color: #3a3a37; }
  .hello__row { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 6px; }

  .ozu { position: relative; margin: 0 auto 110px; width: 640px; max-width: calc(100% - 56px); outline: none; }
  .still { overflow: hidden; }
  .ozu :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1.37 / 1; object-fit: cover; transition: transform 16s ease-out; }
  .ozu:hover :global(img), .ozu:focus-visible :global(img) { transform: scale(1.025); }
  .ozu figcaption { display: flex; justify-content: space-between; padding-top: 10px; font: 400 10px/1.4 var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .ozu figcaption span + span { opacity: 0; transition: opacity 1s 1.5s; }
  .ozu:hover figcaption span + span, .ozu:focus-visible figcaption span + span { opacity: 1; }

  .cs { position: relative; background: radial-gradient(58% 85% at 100% 0%, rgba(196, 36, 24, 0.42), rgba(196, 36, 24, 0) 62%), var(--night); padding: 56px 28px 70px; }
  .safelight { position: absolute; right: 30px; top: 22px; width: 12px; height: 12px; border-radius: 50%; background: #e0301e; box-shadow: 0 0 22px 8px rgba(224, 48, 30, 0.55); }
  .cs__in { max-width: 1320px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px; }
  .cs__label { margin: 0 0 16px; font: 400 9px/1.4 var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--night-muted); }
  .strip { position: relative; background: #161614; padding: 4px 14px 26px; }
  .sprk { height: 12px; background-image: repeating-linear-gradient(90deg, transparent 0 8px, #33332f 8px 16px, transparent 16px 24px); background-size: 24px 7px; background-repeat: repeat-x; background-position: 0 2px; }
  .strip__row { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; padding: 8px 0 10px; }
  .fr { position: relative; aspect-ratio: 3 / 2; background: #1c1c1a; transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s; outline: none; }
  .fr :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fr:hover, .fr:focus-visible { transform: scale(1.75); z-index: 5; box-shadow: 0 0 0 6px var(--night-ink), 0 30px 60px -20px rgba(0, 0, 0, 0.8); }
  .fr .n { position: absolute; left: 0; bottom: -16px; font: 400 9px/1 var(--font-mono); letter-spacing: 0.2em; color: var(--gold); }
  .grease { position: absolute; left: calc(16.66% - 30px); top: -14px; pointer-events: none; }
  .gp { stroke-dasharray: 1; }
  .cs:hover .gp { animation: draw 1.1s ease-out both; }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .thisone { position: absolute; right: 18%; top: -38px; font: 500 30px/1 var(--font-hand); color: var(--gold); rotate: -6deg; }

  .door-row { position: relative; padding: 70px 28px 90px; display: flex; justify-content: flex-end; align-items: center; background: var(--paper); }
  .door-row :global(.cameo) { width: 22px; height: 22px; margin-right: 28px; border-radius: 50%; object-fit: cover; filter: grayscale(1) contrast(1.05); box-shadow: 0 0 0 2px var(--paper); transition: transform 0.4s cubic-bezier(0.3, 0.6, 0.2, 1); }
  .door-row :global(.cameo:hover) { transform: scale(3.2); }
  .door { color: var(--ink); text-decoration: none; display: inline-flex; align-items: baseline; gap: 14px; min-height: 44px; transition: gap 0.4s; }
  .door:hover { gap: 26px; }
  .door span { font: italic 400 clamp(34px, 4vw, 56px) / 1 var(--font-serif); }
  .door i { font: 400 14px/1 var(--font-mono); }

  /* ----- Work with me ----- */
  .cutto { position: relative; height: 150px; background: linear-gradient(180deg, var(--paper), #e8e3d8); display: flex; align-items: flex-end; justify-content: flex-end; padding: 0 56px 26px; }
  .cutto span { font: 400 15px/1 var(--font-script); letter-spacing: 0.04em; }
  .desk { position: relative; background: #e8e3d8; scroll-margin-top: 0; }
  .desk input { position: fixed; top: 50%; left: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .slug8b { display: flex; gap: 18px; margin: 0; font: 400 12.5px/1.4 var(--font-script); letter-spacing: 0.02em; text-transform: uppercase; }
  .slug8b b { font-weight: 400; opacity: 0.62; }
  .howi h2 { margin: 0; font-weight: 600; line-height: 0.92; letter-spacing: -0.05em; }
  .bk-mono { font: 400 10px/1.4 var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }

  /* Wider screens: the booklet you page through */
  @media (min-width: 900px) {
    .hello { flex-wrap: nowrap; gap: clamp(32px, 4.4vw, 64px); }
    .kmr { flex: 0 1 560px; min-width: 0; }
    .hello__text { flex: 1 1 0; min-width: 0; }
    .fl-only { display: none !important; }
    .desk { height: max(700px, calc(900 * var(--u))); overflow: hidden; }
    .slug8b { position: absolute; left: 28px; top: 22px; z-index: 3; }
    .howi { position: absolute; left: calc(56 * var(--u)); top: calc(96 * var(--u)); width: calc(250 * var(--u)); z-index: 3; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
    .howi h2 { font-size: calc(64 * var(--u)); }
    .howi p { margin: 0; font: 400 max(15px, calc(22 * var(--u))) / 1.25 var(--font-serif); }
    .blinds { position: absolute; left: -70px; top: 30px; width: 740px; height: 960px; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr 1fr; gap: 26px; transform: skewX(20deg); transform-origin: 0 0; filter: blur(5px); pointer-events: none; }
    .blinds i { background: rgba(255, 216, 156, 0.44); }

    .book { position: absolute; left: 50%; top: calc(110 * var(--u)); width: calc(880 * var(--u)); height: calc(600 * var(--u)); margin-left: calc(-380 * var(--u)); rotate: -1.2deg; }
    .sp { position: absolute; inset: 0; display: none; justify-content: center; }
    #p0:checked ~ .book .s0, #p1:checked ~ .book .s1, #p2:checked ~ .book .s2, #p3:checked ~ .book .s3, #p4:checked ~ .book .s4 { display: flex; animation: turn 0.75s cubic-bezier(0.3, 0.7, 0.2, 1); }
    @keyframes turn { from { opacity: 0; transform: perspective(1800px) rotateY(-10deg) translateX(30px); } to { opacity: 1; transform: none; } }
    .pg { position: relative; width: 50%; height: 100%; background: #fbfaf6; padding: calc(44 * var(--u)) calc(40 * var(--u)) calc(52 * var(--u)); display: flex; flex-direction: column; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.45); }
    .pg.l { background-image: linear-gradient(270deg, rgba(0, 0, 0, 0.09), rgba(0, 0, 0, 0) 34px); }
    .pg.r { background-image: linear-gradient(90deg, rgba(0, 0, 0, 0.11), rgba(0, 0, 0, 0) 34px); }
    .pg--spread { justify-content: space-between; }
    .pg--cover { background: var(--ink); color: var(--paper); justify-content: space-between; align-items: center; text-align: center; }
    .pg--cover .bk-mono { color: var(--night-muted); }
