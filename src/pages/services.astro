---
// SERVICES & PROCESS. Words are in site-content/pages/services.yaml. No prices anywhere.
import Base from '../layouts/Base.astro';
import { clean, getPage } from '../lib/content.js';

const page = await getPage('services');
const faq = page.faq.filter((item) => clean(item.answer));
const number = (index) => String(index + 1).padStart(2, '0');
---

<Base title="Services & process" current="services" description="Content strategy, long-form and short-form editing, thumbnails, motion graphics, direction and film editing, from one person.">
  <section class="wrap head">
    <div class="label">SERVICES &amp; PROCESS</div>
    <h1 class="h1-huge head__title">{page.title}</h1>
    <p class="statement head__statement">{page.statement}</p>
  </section>

  <section class="wrap gap-section">
    <div class="venn" aria-hidden="true">
      <div class="venn__circle venn__circle--left"><span>Content strategy</span></div>
      <div class="venn__circle venn__circle--right"><span>Filmmaking</span></div>
      <div class="venn__tag">YOU GET BOTH</div>
    </div>
    <div class="compare">
      {page.comparison.map((row) => (
        <div class="compare__row">
          <span class="compare__them">{row.them}</span>
          <span class="compare__me">{row.me}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="band-panel">
    <div class="wrap what">
      <div class="what__head">
        <h2 class="h2">What I do</h2>
        <span class="meta">PICK ONE, OR THE WHOLE PACKAGE</span>
      </div>
      {page.services.map((service, index) => (
        <div class="service">
          <div class="service__title"><span class="meta">{number(index)}</span><span>{service.title}</span></div>
          <span class="service__text">{service.text}</span>
          <div class="tag-row service__outputs">
            {service.outputs.map((output) => <span class="service__output">{output}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap process">
    <div class="process__head">
      <span class="label">THE PROCESS</span>
      <h2 class="h2">From audit to the next cut.</h2>
    </div>
    <ol class="steps">
      {page.process.map((step, index) => (
        <li class="steps__item">
          <span class="steps__when">{number(index)} · {step.when}</span>
          <span class="steps__title">{step.title}</span>
          <span class="steps__text">{step.text}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap ways">
    <div class="ways__head">
      <h2 class="h2 h2--small">Ways to work together</h2>
      <span class="meta">SCOPE &amp; PRICING ON A CALL</span>
    </div>
    <div class="ways__grid">
      {page.ways.map((way) => (
        <div class="way">
          <span class="label label--small">{way.kicker}</span>
          <span class="way__title">{way.title}</span>
          <span class="way__text">{way.text}</span>
          <a class="btn btn--primary way__button" href="/contact#book">Book a call</a>
        </div>
      ))}
    </div>
  </section>

  {faq.length > 0 && (
    <section class="faq-section">
      <div class="faq">
        <h2 class="h2 h2--small faq__title">Questions</h2>
        {faq.map((item) => (
          <details class="faq__item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <section class="band-ink">
    <div class="wrap closing">
      <h2 class="closing__title">{page.cta.title}</h2>
      <a class="btn btn--primary btn--large" href="/contact#book">{page.cta.button}</a>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: 88px 72px; display: flex; flex-direction: column; gap: 28px; }
  .head__title { max-width: 1200px; font-size: clamp(56px, 9vw, 140px); line-height: 0.88; }
  .head__statement { max-width: 820px; font-size: clamp(24px, 2.6vw, 36px); line-height: 1.2; }

  .gap-section { padding-bottom: 96px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .venn { flex: 1 1 420px; position: relative; height: 380px; min-width: min(300px, 100%); }
  .venn__circle { position: absolute; top: 30px; width: 320px; height: 320px; max-width: 62%; border-radius: 50%; border: 1px solid var(--ink); display: flex; align-items: center; font-weight: 600; font-size: 20px; line-height: 1.2; }
  .venn__circle span { max-width: 120px; }
  .venn__circle--left { left: 0; justify-content: flex-start; padding-left: 44px; }
  .venn__circle--right { right: 0; justify-content: flex-end; padding-right: 44px; text-align: right; background: rgb(18 18 18 / 0.06); }
  .venn__tag { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); padding: 10px 14px; background: var(--ink); color: var(--paper); border-radius: var(--radius-pill); font: 500 12px/1 var(--font-mono); letter-spacing: 0.06em; white-space: nowrap; }
  .compare { flex: 1.2 1 min(420px, 100%); display: flex; flex-direction: column; }
  .compare__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; padding-block: 22px; border-top: 1px solid var(--line); }
  .compare__them { font-size: 17px; line-height: 1.45; color: #6a6964; text-decoration: line-through; text-decoration-color: var(--line-strong); }
  .compare__me { font-size: 17px; line-height: 1.45; font-weight: 500; }

  .what { padding-block: 96px; }
  .what__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 32px; }
  .service { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 12px 32px; padding-block: 26px; border-top: 1px solid var(--line-strong); }
  .service__title { display: flex; align-items: baseline; gap: 16px; font-weight: 600; font-size: 26px; line-height: 1.1; letter-spacing: -0.02em; }
  .service__text { font-size: 16px; line-height: 1.55; color: var(--body); }
  .service__outputs { align-content: flex-start; }
  .service__output { padding: 6px 10px; background: var(--paper); border-radius: var(--radius-pill); font: 500 11px/1 var(--font-mono); }

  .process { padding-block: 96px; }
  .process__head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; }
  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  .steps__item { display: flex; flex-direction: column; gap: 12px; padding: 24px 20px 24px 0; border-top: 2px solid var(--ink); }
  .steps__when { font: 500 12px/1 var(--font-mono); letter-spacing: 0.08em; }
  .steps__title { font-weight: 600; font-size: 22px; line-height: 1.15; letter-spacing: -0.02em; }
  .steps__text { font-size: 15px; line-height: 1.55; color: var(--body); }

  .ways { padding-bottom: 96px; }
  .ways__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 28px; }
  .ways__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 16px; }
  .way { min-height: 320px; padding: 28px; border: 1px solid var(--ink); border-radius: var(--radius-card); display: flex; flex-direction: column; gap: 16px; }
  .way__title { font-weight: 600; font-size: 30px; line-height: 1.05; letter-spacing: -0.025em; }
  .way__text { font-size: 16px; line-height: 1.55; color: var(--body); }
  .way__button { margin-top: auto; }

  .faq-section { border-top: 1px solid var(--line); }
  .faq { max-width: 980px; margin-inline: auto; padding: 96px var(--gutter); }
  .faq__title { margin-bottom: 24px; }
  .faq__item { border-top: 1px solid var(--line); padding-block: 4px; }
  .faq__item summary { min-height: 56px; display: flex; align-items: center; cursor: pointer; font-weight: 500; font-size: 19px; list-style: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; margin-left: auto; padding-left: 16px; font: 500 18px/1 var(--font-mono); color: var(--muted); }
  .faq__item[open] summary::after { content: '–'; }
  .faq__item p { margin-bottom: 20px; font-size: 16px; line-height: 1.6; color: var(--body); }

  .closing { padding-block: 112px; display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  .closing__title { font-weight: 600; font-size: clamp(44px, 7vw, 104px); line-height: 0.92; letter-spacing: -0.045em; }

  @media (max-width: 700px) {
    .head { padding-block: 32px 48px; }
    .venn { flex-basis: 100%; height: 300px; }
    .venn__circle { top: 20px; width: 62%; height: auto; aspect-ratio: 1; font-size: 16px; }
    .venn__circle--left { padding-left: 22px; }
    .venn__circle--right { padding-right: 22px; }
    .venn__circle span { max-width: 84px; }
    .what, .process { padding-block: 64px; }
    .steps { grid-template-columns: 1fr 1fr; }
    .ways, .gap-section { padding-bottom: 64px; }
    .way { min-height: 0; }
    .faq { padding-block: 64px; }
    .closing { padding-block: 80px; }
    .closing .btn { width: 100%; }
  }
</style>
