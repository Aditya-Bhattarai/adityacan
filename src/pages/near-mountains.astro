---
// NEAR MOUNTAINS: the trail journal (scene 5, full moon).
// On PCs and laptops the page opens at the bottom, in Kathmandu (1,400 m), and you scroll UP to climb to the moon.
// On phones it reads top to bottom: Kathmandu first, the moon last.
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { getProject, getSettings } from '../lib/content.js';
import { at, clip, day } from '../lib/day.js';

const settings = getSettings();
const langtang = await getProject('langtang-diaries');
const photos = settings.instagramPhotos;
const wa = (text) => settings.whatsapp ? `https://wa.me/${settings.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(text)}` : settings.calendly;
const trekHref = wa('Hi Aditya, I’m planning a trek in Nepal.');

// ---------- WORDS: change the text between the quotes and save ----------
const words = {
  ask: 'Planning a shoot or a trek in Nepal? I can help with both.',
  licence: 'Licensed trekking guide',
  bhojpur: 'Bhojpur, where Mom was born. Getting there was a trek every time. I love that place.',
  amaDablam: 'Ama Dablam. I was too young to even say it right.',
  bus: 'Pokhara, alone on the bus. I was eleven, maybe twelve.',
};
// The three parts of Langtang Diaries on Instagram. "flex" is how long each part is on the bar.
const parts = [
  { title: 'Home calling', href: 'https://www.instagram.com/p/DX_jxU9iWG3/', img: 'archive/62.webp', flex: 34, played: true },
  { title: 'Subtitles that make my videos feel like movie frames', href: 'https://www.instagram.com/p/DfKK9t5JUsQ/', img: 'archive/65.webp', flex: 30 },
  { title: 'Maybe silence is just a perspective away?', href: 'https://www.instagram.com/p/DfQ3cV4ovkD/', img: 'archive/67.webp', flex: 36 },
];
// The strip of negatives. Point at a frame (or tap it) to print it.
const roll = [
  ['best/lt_bridge.jpg', 'A suspension bridge on the way to Langtang, prayer flags along the rails.'],
  ['best/lt_cairn.jpg', 'A cairn of flat stones stacked by the river.'],
  ['best/lt_range_flags.jpg', 'A trekker looking out over prayer flags at the Langtang range.'],
  ['best/lt_flags_snow.jpg', 'Prayer flags heaped on the snow.'],
  ['c/yak_cliff.jpg', 'A yak standing on a cliff edge in the mist.'],
  ['best/bk_stairs.jpg', 'Stone steps climbing into a blue sky, Bhairavkunda.'],
  ['best/lt_mist_trail.jpg', 'The trail running into low cloud.'],
  ['best/peak_blue.jpg', 'A snow peak against a deep blue sky.'],
  ['best/bk_tree.jpg', 'One tree on a ridge above the valley.'],
  ['c/village.jpg', 'Langtang village under the snow line.'],
  ['best/turquoise_lake.jpg', 'A turquoise lake behind a dam, seen from the road.'],
  ['c/puppy.jpg', 'A mountain puppy, held up to the camera.'],
];
// The clips the Langtang player runs through, one after another (all silent, all mine).
const tape = ['best/loop_langtang.mp4', 'w/snow_a.mp4', 'c/flags.mp4', 'w/snow_b.mp4', 'c/ridge_gold.mp4', 'best/loop_icefall.mp4'].map((file) => clip(file));
// Heights down the right edge: how far down the page, the height, and the place.
const heights = [
  [233, '384,400 KM', 'the moon', 'night'], [549, '4,400 M', '', 'night'], [1193, '3,870 M', 'Kyanjin Gompa'], [1642, '3,500 M', ''],
  [2250, '3,000 M', ''], [2857, '2,500 M', ''], [3464, '2,000 M', ''], [4193, '1,400 M', 'Kathmandu'],
];
const road = 'M 700 4246 C 900 4250, 1150 4250, 1150 4100 C 1150 3800, 1150 3700, 1240 3560 C 1340 3420, 1380 3300, 1330 3150 C 1290 3000, 1200 2900, 980 2860 C 600 2800, 260 2620, 330 2520 C 420 2420, 1000 2520, 1100 2400 C 1200 2280, 1360 2200, 1360 2050 C 1360 1900, 980 1780, 900 1760 C 700 1740, 860 1450, 870 1300 C 875 1240, 880 1215, 880 1192';
const walk = 'M 554 394 L 623 365 L 567 342 L 637 318 L 595 290 L 650 266 L 609 237';
---

<Base
  title="Near Mountains."
  description="Aditya Bhattarai is a licensed trekking guide in Nepal who films on the way up: Langtang, Bhairavkunda and the road out of Kathmandu."
  current="mountains" scene="5" slug="EXT. LANGTANG. FULL MOON." navInk="#ECEBE6" sky="#F1F0EC" grain rail={false}
>
  <div class="trail" data-trail>
    <span class="sky d-only" aria-hidden="true"></span>
    <svg class="road d-only" viewBox="0 0 1440 4300" preserveAspectRatio="none" aria-hidden="true">
      <path d={road} fill="none" stroke="#121212" stroke-opacity="0.45" stroke-width="2" stroke-linecap="round" stroke-dasharray="0.1 9"></path>
      <circle cx="700" cy="4246" r="4" fill="#121212"></circle>
      <circle cx="880" cy="1192" r="4" fill="#121212"></circle>
      <g class="car" style={`offset-path: path('${road}')`}><rect x="-6.5" y="-3" width="13" height="6" rx="2" fill="#121212"></rect><rect x="6.5" y="-2" width="3" height="4" rx="1" fill="#E8B23A" opacity=".8"></rect></g>
    </svg>
    <span class="ruler d-only" aria-hidden="true"></span>
    {heights.map(([y, height, place, tone]) => (
      <span class:list={['alt d-only', { 'alt--night': tone }]} style={`--y:${y}`}><b>{height}</b>{place && <i>{place}</i>}</span>
    ))}

    <!-- 0. Kathmandu, 1,400 m. The page opens here. -->
    <section class="s-ktm">
      <h1 class="at" style={at(28, 3660, 800)}>Near<br />Mountains.</h1>
      <p class="hand m-only">{words.amaDablam}</p>
      <figure class="p at boudha" style={at(900, 3640, 420, 1.2)}>
        <Picture image={day('u/trek-boudha.jpg')} alt="Boudhanath at dusk, birds over the stupa." widths={[420, 788]} sizes="(max-width: 900px) 70vw, 29vw" style="aspect-ratio: 4 / 5" eager />
        <figcaption class="mono d-only">{photos ? <a href={photos} target="_blank" rel="noopener">Boudhanath at dusk · @anorigix ↗</a> : 'Boudhanath at dusk'}</figcaption>
      </figure>
      <figure class="p at print d-only" style={at(600, 3996, 280, -1.2)}>
        <Picture image={day('best/v_peaks_wide.jpg')} alt="A snow peak in Langtang against a clear blue sky." widths={[280, 560]} sizes="20vw" style="aspect-ratio: 16 / 9" />
        <figcaption class="mono">Langtang, 2026</figcaption>
      </figure>
      <div class="scrap at d-only" style={`${at(40, 4004, 520, -1.4)};--fs:30`}>{words.amaDablam}</div>
      <p class="mono start d-only"><span class="up">↑</span>&nbsp; The page opens here. Scroll up to climb.</p>
      <div class="mroll m-only" aria-hidden="true">
        <div class="sprk"></div>
        <div class="mroll__row">
          <span class="neg"><Picture image={day('u/trek-tree.jpg')} alt="" widths={[240]} sizes="33vw" /></span>
          <span class="neg neg--on"><Picture image={day('u/trek-village.jpg')} alt="" widths={[240]} sizes="33vw" /></span>
          <span class="neg"><Picture image={day('u/trek-horse.jpg')} alt="" widths={[240]} sizes="33vw" /></span>
        </div>
      </div>
    </section>

    <!-- I. Bhojpur -->
    <section class="s-bhojpur">
      <p class="mslug m-only"><span>1,400 M</span><span>KATHMANDU. SCROLL DOWN TO CLIMB.</span></p>
      <div class="scrap at" style={`${at(800, 3270, 460, 1.2)};--fs:28`}>{words.bhojpur}</div>
      <div class="pols">
        <div class="pol at" tabindex="0" style={at(110, 3180, 300, -3)}>
          <span class="em"><Picture image={day('c/toddler.jpg')} alt="Me, very small, in a striped sweater and a paper crown." widths={[300, 600]} sizes="(max-width: 900px) 45vw, 20vw" /></span><b>me, small</b>
        </div>
        <div class="pol at" tabindex="0" style={at(470, 3236, 260, 2.4)}>
          <span class="em"><Picture image={day('c/kid_lake.jpg')} alt="Me as a boy, leaning on a railing by a lake." widths={[300, 600]} sizes="(max-width: 900px) 45vw, 18vw" style="object-position: 62% 50%" /></span><b>a bit bigger</b>
        </div>
      </div>
    </section>

    <!-- II. Pokhara, alone -->
    <section class="s-pokhara">
      <figure class="p at rain d-only" tabindex="0" style={at(40, 2654, 280, -1.6)}>
        <div class="glass">
          <Picture image={day('rain.jpg')} alt="Rain on a window, a white car and a red light blurred behind it." widths={[280, 560]} sizes="20vw" />
          <Picture image={day('rain_wiped.jpg')} alt="" widths={[280, 560]} sizes="20vw" class="wiped" />
          <span class="arm"></span>
        </div>
        <figcaption class="mono">after Kiarostami · hover for the wiper</figcaption>
      </figure>
      <figure class="p at bus" style={at(340, 2580, 980)}>
        <div class="bus__in">
          <Picture image={day('u/trek-road.jpg')} alt="A mountain road, empty." widths={[700, 1050]} sizes="(max-width: 900px) 100vw, 68vw" style="aspect-ratio: 16 / 9" />
          <span class="bus__line d-only">{words.bus}</span>
          <span class="vf m-only"></span>
          <span class="card__t m-only"><b>The road out</b><small>by bus, first</small></span>
        </div>
      </figure>
    </section>

    <!-- III. The roll: touch a frame to print it -->
    <section class="s-roll">
      <p class="mslug m-only"><span>2,500 M</span><span>ON THE TRAIL.</span></p>
      <div class="mcard m-only">
        <video data-loop data-src={clip('c/flags.mp4')} poster={(await import('astro:assets').then((m) => m.getImage({ src: day('c/flags_poster.jpg'), width: 800, format: 'webp' }))).src} muted loop playsinline preload="none" aria-label="Prayer flags moving in the wind over the valley. My footage." style="aspect-ratio: 16 / 10"></video>
        <span class="vf"></span><span class="card__t"><b>Prayer flags</b><small>my footage</small></span>
      </div>
      <div class="roll at" data-slide style={at(-30, 2290, 1500, -1.2)}>
        <div class="sprk d-only"></div>
        <div class="roll__row" data-slide-row tabindex="0" aria-label="A roll of negatives. Slide sideways for more.">
          {roll.map(([img, alt], index) => (
            <a class="neg" href={photos || '/everything'} target={photos ? '_blank' : undefined} rel={photos ? 'noopener' : undefined}>
              <Picture image={day(img)} alt={alt} widths={[300, 600]} sizes="(max-width: 900px) 62vw, 20vw" />
              <span class="num" aria-hidden="true">{index === 0 ? '▸ ' : ''}{21 + Math.floor(index / 2)}{index % 2 ? 'A' : ''}</span>
            </a>
          ))}
        </div>
        <div class="sprk d-only"></div>
        <button class="roll__go roll__go--back" type="button" data-slide-back aria-label="Earlier frames">←</button>
        <button class="roll__go roll__go--on" type="button" data-slide-on aria-label="More frames">→</button>
        <p class="roll__hint">{roll.length} frames · slide for more</p>
      </div>
      <div class="mcard m-only">
        <video data-loop data-src={clip('c/mule.mp4')} poster={(await import('astro:assets').then((m) => m.getImage({ src: day('c/mule_poster.jpg'), width: 480, format: 'webp' }))).src} muted loop playsinline preload="none" aria-label="A mule walking the trail with its load. My footage." style="aspect-ratio: 4 / 5"></video>
        <span class="vf"></span><span class="card__t"><b>Everyone carries something.</b><small>Langtang</small></span>
      </div>
    </section>

    <!-- IV. Two of my own photographs -->
    <section class="s-prints d-only">
      <figure class="p at print" style={at(120, 1806, 820)}>
        <Picture image={day('range.jpg')} alt="A Himalayan range at dusk, the last light on the snow." widths={[820, 1260]} sizes="57vw" style="aspect-ratio: 1260 / 543" />
        <figcaption class="mono">{photos ? <a href={photos} target="_blank" rel="noopener">Last light on the range · @anorigix ↗</a> : 'Last light on the range'}</figcaption>
      </figure>
      <figure class="p at print" style={at(1010, 1790, 300, 1.4)}>
        <Picture image={day('terraces.jpg')} alt="Terraced fields from above, one small house among them." widths={[300, 600]} sizes="21vw" style="aspect-ratio: 1000 / 1217" />
        <figcaption class="mono">{photos ? <a href={photos} target="_blank" rel="noopener">Terraces · @anorigix ↗</a> : 'Terraces'}</figcaption>
      </figure>
    </section>

    <!-- V. Langtang -->
    <section class="s-langtang">
      <p class="mslug m-only"><span>3,870 M</span><span>KYANJIN GOMPA.</span></p>
      <div class="p at film" style={at(28, 1240, 820)}>
        <div class="film__in" data-seq={JSON.stringify(tape)}>
          <Picture image={day('best/v_langtang_village.jpg')} alt="Langtang village under the snow peaks." widths={[640, 960]} sizes="(max-width: 900px) 100vw, 57vw" style="aspect-ratio: 16 / 9" />
          <video class="film__loop" data-seq-video muted playsinline preload="none" aria-label="Clips from Langtang, one after another: the village, snow, prayer flags, the ridge at first light. My footage, silent."></video>
          <span class="shade"></span>
          <button class="play" type="button" data-seq-toggle aria-label="Play">
            <svg class="i-play" width="22" height="24" viewBox="0 0 22 24" aria-hidden="true"><path d="M2 1 L21 12 L2 23 Z" fill="#121212"></path></svg>
            <svg class="i-pause" width="20" height="24" viewBox="0 0 20 24" aria-hidden="true"><path d="M2 1 H8 V23 H2 Z M12 1 H18 V23 H12 Z" fill="#121212"></path></svg>
          </button>
          <span class="prog" aria-hidden="true"><i data-seq-fill></i></span>
          <div class="chap d-only">
            {parts.map((part, index) => (
              <a class="seg" href={part.href} target="_blank" rel="noopener" style={`flex:${part.flex}`} aria-label={`Part ${index + 1}: ${part.title}. Opens on Instagram.`}>
                <span class="pv"><Picture image={day(part.img)} alt="" widths={[192]} sizes="96px" /><b>{part.title}</b><small>PART {index + 1} · ON INSTAGRAM ↗</small></span>
              </a>
            ))}
          </div>
          <span class="vf m-only"></span>
          <a class="card__t film__m m-only" href={parts[0].href} target="_blank" rel="noopener"><b>Langtang Diaries</b><small>3 parts · watch on Instagram ↗</small></a>
        </div>
        <span class="mono film__cap d-only">{langtang ? <a href={langtang.href}>Langtang Diaries</a> : 'Langtang Diaries'} · 3 parts on Instagram · hover the bar</span>
      </div>
      <figure class="p at wc d-only" style={at(900, 1236, 360, -1.4)}>
        <Picture image={day('u/sketch-kyanjin.jpg')} alt="A pencil sketch: a trekker, face wrapped against the wind, under the peaks." widths={[360, 720]} sizes="25vw" style="aspect-ratio: 4 / 5" />
        <figcaption>Kyanjin, 2026</figcaption>
      </figure>
      <div class="mcard m-only">
        <video data-loop data-src={clip('c/ridge_gold.mp4')} poster={(await import('astro:assets').then((m) => m.getImage({ src: day('c/ridge_gold_poster.jpg'), width: 480, format: 'webp' }))).src} muted loop playsinline preload="none" aria-label="Morning light moving down a snow ridge above Langtang village. My footage." style="aspect-ratio: 4 / 5"></video>
        <span class="vf"></span><span class="card__t"><b>First light on the ridge</b><small>my footage</small></span>
      </div>
    </section>

    <!-- VI. Kyanjin Gompa: the top of the climb -->
    <section class="s-top">
      <p class="mslug m-only"><span>4,400 M</span><span>LOWER KYANJIN RI.</span></p>
      <div class="p at olive d-only" tabindex="0" style={at(28, 600, 1384)}>
        <Picture image={day('hills.jpg')} alt="Terraced hills and a village under the Himalaya, seen from far off." widths={[1000, 1600]} sizes="96vw" />
        <svg class="walkers" viewBox="0 0 1384 579" preserveAspectRatio="none" aria-hidden="true">
          <path d={walk} pathLength="1"></path>
          <rect class="fg a" x="-1.5" y="-5" width="3" height="5" rx="1.5" style={`offset-path: path('${walk}')`}></rect>
          <rect class="fg b" x="-1.5" y="-4.6" width="3" height="4.6" rx="1.5" style={`offset-path: path('${walk}')`}></rect>
        </svg>
        <a class="ev" href={parts[0].href} target="_blank" rel="noopener" style="left: 2.9%"><Picture image={day('archive/66.webp')} alt="Langtang village from above." widths={[240, 480]} sizes="17vw" /><span>Langtang Diaries</span></a>
        <div class="es">
          <Picture image={day('u/portrait-bw.jpg')} alt="Aditya." widths={[168]} sizes="84px" />
          <a href={wa('Hi Aditya, I found you on adityacan.com.')} target="_blank" rel="noopener">Talk to me</a>
        </div>
        <a class="ev r" href="/everything" style="right: 2.9%"><Picture image={day('archive/58.webp')} alt="Above the clouds at Bhairavkunda." widths={[240, 480]} sizes="17vw" /><span>Everything</span></a>
      </div>
      <p class="mono olive__cap d-only">The top · after Through the Olive Trees · hover and they walk</p>
      <figure class="snap at snap--clip d-only" style={at(850, 352, 150, -2.2)}>
        <span class="snap__in">
          <Picture image={day('best/v_sunrise_clouds.jpg')} alt="Sunrise above the clouds at Bhairavkunda." widths={[150, 300]} sizes="11vw" style="aspect-ratio: 9 / 16" />
          <video data-loop data-src={clip('best/loop_sunrise.mp4')} muted loop playsinline preload="none" aria-label="Sunrise above the clouds at Bhairavkunda, my footage, silent."></video>
        </span>
        <figcaption>Bhairavkunda, 6:39</figcaption>
      </figure>
      <figure class="snap at hat" style={at(1036, 420, 262, 1.8)}>
        <Picture image={day('best/lt_hat2.jpg')} alt="My orange hat with cartoon eyes, set down in front of the Langtang range." widths={[480, 840]} sizes="(max-width: 900px) 100vw, 18vw" style="aspect-ratio: 4 / 3" />
        <figcaption class="d-only">The hat made it to 4,400 m.</figcaption>
        <span class="vf m-only"></span><span class="card__t m-only"><b>The hat made it.</b><small>4,400 m</small></span>
      </figure>
      <div class="mcard m-only">
        <Picture image={day('c/shadow_hat.jpg')} alt="My shadow on the snow, hat and all." widths={[480, 840]} sizes="100vw" style="aspect-ratio: 4 / 5; object-position: 50% 85%" />
        <span class="vf"></span><span class="card__t"><b>So did I.</b></span>
      </div>
    </section>

    <!-- VII. Above Kyanjin there is only sky -->
    <section class="s-moon">
      <p class="mslug m-only"><span>384,400 KM</span><span>THE MOON.</span></p>
      <figure class="moon"><Picture image={day('moon.jpg')} alt="A full moon, photographed by Aditya." widths={[250, 500]} sizes="(max-width: 900px) 190px, 17vw" /></figure>
      {photos && <a class="mono moon__cap d-only" href={photos} target="_blank" rel="noopener">Full moon · @anorigix ↗</a>}
      <div class="mcard m-only">
        <Picture image={day('c/white_horse.jpg')} alt="A white horse grazing in the dark, blurred like a ghost." widths={[480, 840]} sizes="100vw" style="aspect-ratio: 4 / 5" />
        <span class="vf"></span><span class="card__t"><b>A white horse after dark</b><small>Langtang</small></span>
      </div>
      <div class="ask at" style={at(40, 150, 820)}>
        <span class="mono d-only">The top of the page</span>
        <p>{words.ask}</p>
        <div class="ask__row">
          <a class="pill pill--solid" href={trekHref} target="_blank" rel="noopener">Plan a trek with me</a>
          <a class="pill pill--line" href="/contact">Contact me</a>
          <span class="mono">{words.licence}</span>
        </div>
      </div>
    </section>
  </div>
</Base>

<script src="../scripts/loops.js"></script>
<script src="../scripts/sequence.js"></script>
<script is:inline>
  // PCs and laptops: the journal opens at the bottom (Kathmandu) and you scroll up to climb.
  // Skipped when the address points at a place on the page, or when you come back to where you were.
  (function () {
    var trail = document.querySelector('[data-trail]');
    if (!trail || location.hash || !window.matchMedia('(min-width: 900px)').matches) return;
    if (history.scrollRestoration) history.scrollRestoration = 'manual';
    var go = function () { window.scrollTo(0, trail.offsetTop + trail.offsetHeight - window.innerHeight); };
    go();
    window.addEventListener('load', go, { once: true });
  })();
</script>

<style is:global>
  /* Phones start in daylight in Kathmandu, so the menu and scene line are dark there. */
  @media (max-width: 899.98px) { .scene { --nav-ink: #121212 !important; } }
</style>

<style>
  .trail { position: relative; }
  .trail a { color: inherit; }
  .mono { margin: 0; font: 400 10px/1.5 var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .mono a { text-decoration: none; border-bottom: 1px solid currentColor; }
  h1 { margin: 0; font-weight: 600; line-height: 0.86; letter-spacing: -0.05em; }
  .p { margin: 0; }
  .p :global(img) { display: block; width: 100%; height: auto; object-fit: cover; box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.45); }
  .p figcaption { padding-top: 10px; }
  .scrap { position: relative; background: #fbf8f0; background-image: repeating-linear-gradient(180deg, transparent 0 33px, rgba(90, 120, 160, 0.22) 33px 34px); padding: 18px 24px 20px; box-shadow: 0 14px 30px -18px rgba(0, 0, 0, 0.45); font: 500 28px/34px var(--font-hand); color: #2f2a24; transition: translate 0.5s ease, box-shadow 0.5s ease; }
  .scrap::before { content: ""; position: absolute; top: -10px; left: 40%; width: 80px; height: 20px; background: rgba(236, 228, 205, 0.8); transform: rotate(-4deg); }
  .scrap:hover { translate: 0 -6px; box-shadow: 0 26px 40px -20px rgba(0, 0, 0, 0.5); }
  .sprk { height: 16px; background-image: repeating-linear-gradient(90deg, transparent 0 10px, #f1e3c8 10px 21px, transparent 21px 31px); background-size: 31px 9px; background-repeat: repeat-x; background-position: 0 3px; }
  .neg { position: relative; overflow: hidden; flex: 1; display: block; }
  .neg :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; filter: invert(1) contrast(0.85); transition: filter 0.7s ease; }
  .neg::after { content: ""; position: absolute; inset: 0; background: #d57a2e; mix-blend-mode: multiply; opacity: 0.62; transition: opacity 0.7s ease; pointer-events: none; }
  .neg:hover :global(img), .neg:active :global(img), .neg:focus-visible :global(img), .neg--on :global(img) { filter: none; }
  .neg:hover::after, .neg:active::after, .neg:focus-visible::after, .neg--on::after { opacity: 0; }
  .pol { position: relative; background: #fbfaf6; padding: 14px 14px 60px; box-shadow: 0 18px 36px -20px rgba(0, 0, 0, 0.5); outline: none; }
  .em { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: radial-gradient(120% 90% at 30% 25%, #4c443b 0%, #2d2823 55%, #1c1916 100%); }
  .em :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; filter: sepia(0.18) contrast(0.96); }
