---
// A video that only loads when someone clicks it, so pages stay fast.
// YouTube and Vimeo play in place. Any other link opens in a new tab.
import Picture from './Picture.astro';

const {
  video,
  poster = null,
  ratio = '16/9',
  sizes = '(max-width: 700px) 100vw, 90vw',
  widths = [640, 1280],
  eager = false,
  large = false,
} = Astro.props;

const label = `Play ${video.title || 'video'}`;
const external = video.provider === 'external';
const Tag = external ? 'a' : 'button';
---

<Tag
  class:list={['video', { 'video--large': large }]}
  style={`aspect-ratio:${ratio}`}
  type={external ? undefined : 'button'}
  href={external ? video.url : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  data-video={external ? undefined : video.embed}
  data-title={video.title}
  aria-label={label}
>
  {poster ? (
    <Picture image={poster} alt="" widths={widths} sizes={sizes} eager={eager} class="video__image" />
  ) : video.thumbnail ? (
    <img class="video__image" src={video.thumbnail} alt="" loading="lazy" decoding="async" width="480" height="360" />
  ) : (
    <span class="video__blank"></span>
  )}
  <span class="video__play" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
  </span>
</Tag>

<script src="../scripts/video.js"></script>

<style>
  .video {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
  }
  .video :global(.video__image), .video__blank {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video__play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52px;
    height: 52px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 200ms ease;
  }
  .video__play svg { width: 18px; height: 18px; }
  .video--large .video__play { width: 84px; height: 84px; }
  .video--large .video__play svg { width: 28px; height: 28px; }
  .video:hover .video__play { transform: translate(-50%, -50%) scale(1.06); }
  @media (max-width: 700px) {
    .video--large .video__play { width: 64px; height: 64px; }
  }
</style>
