---
// A typographic tile, used wherever a project has no picture yet.
// Same framing as the chapter title cards, so a missing image still looks intentional.
const { kicker = '', title = '', ratio = '16/10', dark = false } = Astro.props;
---

<div class:list={['title-tile', { 'title-tile--dark': dark }]} style={`aspect-ratio:${ratio}`}>
  <div class="title-tile__inner">
    {kicker && <span class="title-tile__kicker">{kicker}</span>}
    <span class="title-tile__title">{title}</span>
  </div>
</div>

<style>
  .title-tile {
    container-type: inline-size;
    width: 100%;
    padding: 10px;
    border-radius: var(--radius-card);
    background: var(--card);
    color: var(--fg);
  }
  .title-tile--dark { background: var(--night); color: var(--night-ink); }
  .title-tile__inner {
    height: 100%;
    padding: 6cqw;
    border: 1px solid currentColor;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3cqw;
    text-align: center;
  }
  .title-tile__kicker {
    font: 500 clamp(9px, 2.6cqw, 12px)/1.3 var(--font-mono);
    letter-spacing: 0.24em;
    opacity: 0.75;
  }
  .title-tile__title {
    font-weight: 600;
    font-size: clamp(22px, 10cqw, 64px);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
</style>
