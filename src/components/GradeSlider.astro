---
// Before/after colour slider. Drag it, or use the arrow keys.
import Picture from './Picture.astro';

const { before, after } = Astro.props;
---

<div class="grade" data-grade style={`aspect-ratio:${before.width}/${before.height}`}>
  <Picture image={before} alt="The flat log camera file" widths={[480, 960]} sizes="(max-width: 700px) 100vw, 420px" class="grade__image" />
  <div class="grade__after">
    <Picture image={after} alt="The same frame after colour grading" widths={[480, 960]} sizes="(max-width: 700px) 100vw, 420px" class="grade__image" />
  </div>
  <span class="grade__word grade__word--left">LOG</span>
  <span class="grade__word grade__word--right">GRADE</span>
  <div class="grade__line" aria-hidden="true"><span>⟷</span></div>
  <input class="grade__input" type="range" min="0" max="100" value="50" aria-label="Drag to compare before and after" />
</div>

<script src="../scripts/grade.js"></script>

<style>
  .grade {
    --position: 50%;
    position: relative;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-thumb);
    background: var(--card);
    touch-action: pan-y;
  }
  .grade :global(.grade__image) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .grade__after { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--position)); }
  .grade__word { position: absolute; bottom: 12px; padding: 5px 8px; border-radius: var(--radius-pill); background: rgb(15 15 14 / 0.75); color: var(--night-ink); font: 500 10px/1 var(--font-mono); letter-spacing: 0.1em; }
  .grade__word--left { left: 12px; }
  .grade__word--right { right: 12px; }
  .grade__line { position: absolute; top: 0; bottom: 0; left: var(--position); width: 2px; transform: translateX(-1px); background: var(--night-ink); pointer-events: none; }
  .grade__line span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 48px;
    height: 48px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--night-ink);
    color: var(--night);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 500 13px/1 var(--font-mono);
  }
  .grade__input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .grade__input:focus-visible ~ .grade__line,
  .grade:has(.grade__input:focus-visible) .grade__line { outline: 2px solid var(--night-ink); outline-offset: 2px; }
</style>
