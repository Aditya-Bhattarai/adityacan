---
// BOTTOM OF EVERY PAGE: the call sheet (ways to reach Aditya), the "Every scene" list of all pages, the big name.
// Contact details come from site-content/about/bio.md. The page list comes from src/lib/scenes.js
import { SCENE_INDEX } from '../lib/scenes.js';
import { getSettings, handleFrom } from '../lib/content.js';

const { current = '', scene = '', dark = false } = Astro.props;
const settings = getSettings();
const sceneLabel = /^\d$/.test(scene) ? `0${scene}` : scene;

const cells = [
  settings.email && { k: 'Email', v: settings.email, href: `mailto:${settings.email}` },
  settings.whatsapp && { k: 'WhatsApp', v: settings.whatsapp, href: settings.whatsappHref, out: true },
  { k: 'Contact me', v: 'Call, WhatsApp or email', href: '/contact' },
  settings.instagram && { k: 'Instagram', v: handleFrom(settings.instagram), href: settings.instagram, out: true },
  settings.instagramPhotos && { k: 'My photographs', v: handleFrom(settings.instagramPhotos), href: settings.instagramPhotos, out: true },
  settings.linkedin && { k: 'LinkedIn', v: settings.name, href: settings.linkedin, out: true },
  settings.location && { k: 'Location', v: settings.location },
  { k: 'Call time', v: 'Whenever you like. I usually reply right away.', serif: true },
].filter(Boolean);
---

<footer class:list={['csh', { dk: dark }]}>
  <div class="csh__in">
    <div class="csh__hd">
      <b>CALL SHEET</b>
      <span>Production · {settings.name}</span>
      {sceneLabel && <span>Scene {sceneLabel} · day one of many</span>}
      <span>Kathmandu · UTC+5:45</span>
    </div>

    <div class="csh__gr">
      {cells.map((cell) => cell.href ? (
        <a class="csh__c" href={cell.href} target={cell.out ? '_blank' : undefined} rel={cell.out ? 'noopener' : undefined}>
          <span class="csh__k">{cell.k}</span>
          <span class="csh__v">{cell.v}</span>
          <span class="csh__ar" aria-hidden="true">↗</span>
        </a>
      ) : (
        <div class="csh__c">
          <span class="csh__k">{cell.k}</span>
          <span class:list={['csh__v', { 'csh__v--s': cell.serif }]}>{cell.v}</span>
        </div>
      ))}
    </div>

    <nav class="csh__idx" aria-label="Every page">
      <span>Every scene</span>
      {SCENE_INDEX.map((item) => (
        <a href={item.href} class={current === item.key ? 'on' : ''}><b>{item.number}</b>{item.label}</a>
      ))}
    </nav>

    <div class="csh__wm">
      <span>{settings.name}</span>
      <small>Filmmaker · editor · trekking guide · adityacan.com</small>
    </div>
  </div>
</footer>
