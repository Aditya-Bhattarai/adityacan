---
// Shows one image in modern formats (AVIF and WebP), sized for each device, loaded only when needed.
// Use: <Picture image={item.image} alt="..." widths={[320, 640]} sizes="50vw" />
import { Picture as AstroPicture } from 'astro:assets';

const {
  image,
  alt = '',
  widths = [480, 960],
  sizes = '(max-width: 700px) 100vw, 33vw',
  eager = false,
  class: className,
  style,
} = Astro.props;

// Add an in-between size wherever two sizes are far apart, so a phone is not handed a picture much bigger than it needs.
const sorted = [...widths].sort((a, b) => a - b);
const dense = sorted.flatMap((width, index) => {
  const next = sorted[index + 1];
  return next && next / width >= 1.6 ? [width, Math.round((width + next) / 2 / 10) * 10] : [width];
});
// Never ask for a size bigger than the original file.
const finalWidths = [...new Set(dense.map((width) => Math.min(width, image.width)))];
---

<AstroPicture
  src={image}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={finalWidths}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  class={className}
  style={style}
/>
