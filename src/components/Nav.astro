---
// TOP OF EVERY PAGE: name, live Kathmandu clock, sun and moon dial, the six links, the gold pill.
// On phones: name + MENU, which opens the full-screen dark menu.
// The links come from src/lib/scenes.js
import NavIcon from './NavIcon.astro';
import { MENU_MORE, NAV_LINKS } from '../lib/scenes.js';
import { getSettings } from '../lib/content.js';

const { current = '', note = '' } = Astro.props;
const settings = getSettings();
---

<header class="nav">
  <div class="nav__id">
    <a class="nav__name" href="/">{settings.name}</a>
    <span class="nav__clock">KTM <span data-timecode>00:00:00:00</span></span>
    {note && <span class="nav__note" data-golden>{note}</span>}
    <svg class="dial" width="28" height="28" viewBox="0 0 28 28" role="img" aria-label="Where the sun or moon is over Kathmandu right now.">
      <circle cx="14" cy="14" r="10.5" fill="none" stroke="currentColor" stroke-opacity=".5" stroke-width="1.1" stroke-dasharray="0.1 3.3" stroke-linecap="round"></circle>
      <line x1="1" y1="14" x2="27" y2="14" stroke="currentColor" stroke-opacity=".5" stroke-width="1"></line>
      <circle data-dial cx="3.5" cy="14" r="3.3" fill="#E8B23A"></circle>
    </svg>
  </div>

  <nav class="nav__links" aria-label="Main">
    {NAV_LINKS.map((link) => (
      <a href={link.href} class={current === link.key ? 'on' : ''} aria-current={current === link.key ? 'page' : undefined}>
        <NavIcon name={link.icon} />{link.label}
      </a>
    ))}
    <a class="wwm" href="/me#work">Work with me</a>
  </nav>

  <button class="nav__menu-btn" type="button" data-menu-open aria-haspopup="dialog">MENU</button>
</header>

<dialog class="menu" data-menu aria-label="Menu">
  <div class="menu__bar">
    <a class="nav__name" href="/">{settings.name}</a>
    <button class="nav__menu-btn" type="button" data-menu-close>CLOSE</button>
  </div>
  <nav class="menu__links" aria-label="Main, phone">
    {NAV_LINKS.map((link) => (
      <a href={link.href} class:list={[{ on: current === link.key, 'menu__me': link.key === 'about' }]}>
        <NavIcon name={link.icon} size={32} />{link.label}
      </a>
    ))}
  </nav>
  <div class="menu__more">
    {MENU_MORE.map((link) => <a href={link.href}>{link.label}</a>)}
  </div>
  <div class="menu__foot">
    <span class="nav__clock">KTM <span data-timecode>00:00:00:00</span></span>
    <a class="menu__pill" href="/me#work">Work with me</a>
  </div>
</dialog>

<script src="../scripts/nav.js"></script>
