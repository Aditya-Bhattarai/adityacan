---
// The small film objects beside each menu link. Each has one gold part and does one small move
// when pointed at, on the page you are on, and once when the phone menu opens (see frame.css).
const { name, size = 20 } = Astro.props;
---

{name === 'film' && (
  <svg class="ni ni-film" aria-hidden="true" width={size} height={size} viewBox="0 0 24 24">
    <g class="mv"><circle cx="11" cy="11" r="8.2" /><circle cx="11" cy="11" r="1.4" class="gf" /><circle cx="11" cy="6.6" r="1.7" /><circle cx="15.4" cy="11" r="1.7" /><circle cx="11" cy="15.4" r="1.7" /><circle cx="6.6" cy="11" r="1.7" /></g>
    <path d="M11 19.2 H22.5" class="g" />
  </svg>
)}
{name === 'creators' && (
  <svg class="ni ni-creators" aria-hidden="true" width={size} height={size} viewBox="0 0 24 24">
    <rect x="2.5" y="10" width="19" height="11" rx="1.2" /><path d="M2.5 14.2 H21.5" />
    <g class="mv"><path d="M2.5 10 L20.6 4.6 L21.4 7.2 L3.3 12.6 Z" /><path d="M7 8.6 L9.2 11.3 M11.6 7.3 L13.8 10 M16.2 5.9 L18.4 8.6" class="g" /></g>
  </svg>
)}
{name === 'mountains' && (
  <svg class="ni ni-mountains" aria-hidden="true" width={size} height={size} viewBox="0 0 24 24">
    <svg x="0" y="0" width="24" height="13" overflow="hidden"><g class="mv"><circle cx="17.5" cy="9.6" r="2.6" class="gf" /></g></svg>
    <path d="M1.5 21 L9 8.5 L13.2 15 L16 11 L22.5 21" /><path d="M7.2 11.5 L9 8.5 L10.9 11.4" />
  </svg>
)}
{name === 'classes' && (
  <svg class="ni ni-classes" aria-hidden="true" width={size} height={size} viewBox="0 0 24 24">
    <path d="M2.5 21 H8 V16 H13.5 V11 H19 V6 H21.5" /><path d="M2.5 21 H21.5 V6" opacity=".35" />
    <g class="mv"><circle cx="5.2" cy="18.8" r="1.6" class="gf" /></g>
  </svg>
)}
{name === 'everything' && (
  <svg class="ni ni-everything" aria-hidden="true" width={size} height={size} viewBox="0 0 24 24">
    <rect x="2" y="5" width="20" height="14" rx="1.2" />
    <svg x="2.6" y="5" width="18.8" height="14" overflow="hidden"><g class="mv">
      <path d="M1 3 H2 M5 3 H6 M9 3 H10 M13 3 H14 M17 3 H18 M21 3 H22 M25 3 H26 M1 11 H2 M5 11 H6 M9 11 H10 M13 11 H14 M17 11 H18 M21 11 H22 M25 11 H26" />
      <rect x="0.6" y="5" width="5" height="4" rx=".4" /><rect x="7" y="5" width="5" height="4" rx=".4" class="gs" /><rect x="13.4" y="5" width="5" height="4" rx=".4" /><rect x="19.8" y="5" width="5" height="4" rx=".4" />
    </g></svg>
  </svg>
)}
{name === 'me' && (
  <svg class="ni ni-me" aria-hidden="true" width={size} height={size} viewBox="0 0 24 24">
    <svg x="0" y="0" width="24" height="17" overflow="hidden"><g class="mv"><circle cx="12" cy="17.5" r="4.6" class="gf" /><path d="M12 9.6 V8 M6.6 12 L5.4 10.9 M17.4 12 L18.6 10.9" class="g" /></g></svg>
    <path d="M1.5 17 H22.5" /><path d="M5 20.5 H19" opacity=".5" />
  </svg>
)}
