---
// The frame around every page: <head> details, navigation and footer.
import '@fontsource/inter-tight/latin-400.css';
import '@fontsource/inter-tight/latin-500.css';
import '@fontsource/inter-tight/latin-600.css';
import '@fontsource/inter-tight/latin-700.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/noto-sans-devanagari/devanagari-600.css';
import '../styles/tokens.css';
import '../styles/global.css';

import displayFont from '@fontsource/inter-tight/files/inter-tight-latin-600-normal.woff2?url';
import { getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getImages, getSettings } from '../lib/content.js';

const {
  title,
  description = 'Filmmaker and content strategist from Kathmandu, Nepal. Content, directed like films. Built to perform.',
  current = '',
  theme = 'light',
  image = null,
  jsonLd = null,
  noindex = false,
} = Astro.props;

const settings = getSettings();
const pageTitle = title ? `${title} — ${settings.name}` : `${settings.name} — Filmmaker & content strategist, Kathmandu`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);

// Sharing image: the project's cover if given, otherwise the homepage poster.
const shareSource = image ?? getImages('00-home/hero-reel').find((item) => item.path.includes('poster-wide'))?.image;
const shareImage = shareSource
  ? await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 76 })
  : null;
const shareUrl = shareImage ? new URL(shareImage.src, Astro.site) : null;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: settings.name,
  url: Astro.site?.href,
  jobTitle: 'Filmmaker and content strategist',
  address: { '@type': 'PostalAddress', addressLocality: 'Kathmandu', addressCountry: 'NP' },
  email: settings.email ? `mailto:${settings.email}` : undefined,
  sameAs: [settings.instagram, settings.linkedin, settings.youtube, settings.vimeo].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={theme === 'dark' ? '#0F0F0E' : '#F1F0EC'} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {shareUrl && <meta property="og:image" content={shareUrl.href} />}
    {shareUrl && <meta property="og:image:width" content="1200" />}
    {shareUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <slot name="head" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body id="top" class={theme === 'dark' ? 'theme-night' : ''}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
