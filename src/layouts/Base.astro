---
// The frame around every page: <head> details, navigation and footer.
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/courier-prime/latin-400.css';
import '@fontsource/caveat/latin-500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/frame.css';

import displayFont from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getImages, getSettings } from '../lib/content.js';

const {
  title,
  // What Google shows under the site's name. Keep it to about 150 characters.
  description = 'Aditya Bhattarai is a filmmaker and content strategist from Kathmandu, Nepal. 400+ videos edited and 750M+ impressions across YouTube, podcasts, reels and short films.',
  current = '',
  theme = 'light',
  // The scene: its number, its screenplay slugline, and its sky (a CSS background for that hour).
  scene = '',
  slug = '',
  sky = '',
  // Text colour on the sky, and on the menu if that differs (a light page with a dark top, like Home).
  ink = '',
  navInk = '',
  // Small note beside the clock, e.g. "golden hour at 17:21".
  note = '',
  grain = false,
  rail = true,
  // Pages built on the old layouts need room under the menu. Full designs place things themselves.
  pad = false,
  footerDark = theme === 'dark',
  image = null,
  jsonLd = null,
  noindex = false,
} = Astro.props;

const settings = getSettings();
const pageTitle = title ? `${title} | ${settings.name}` : `${settings.name} | Filmmaker and content strategist`;
// The clean address of this page, like /about (never /about.html).
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site);

// Sharing image: the project's cover if given, otherwise the title card (00-home/hero-reel/share-card.jpg).
const shareSource = image ?? getImages('00-home/hero-reel').find((item) => item.path.includes('share-card'))?.image;
const shareImage = shareSource
  ? await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 76 })
  : null;
const shareUrl = shareImage ? new URL(shareImage.src, Astro.site) : null;

// Your portrait, for search engines (site-content/about/portrait/).
const portraitSource = getImages('about/portrait')[0]?.image;
const portraitImage = portraitSource ? await getImage({ src: portraitSource, width: 800, format: 'jpeg', quality: 80 }) : null;

const person = {
  image: portraitImage ? new URL(portraitImage.src, Astro.site).href : undefined,
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: settings.name,
  url: Astro.site?.href,
  jobTitle: 'Filmmaker and content strategist',
  address: { '@type': 'PostalAddress', addressLocality: 'Kathmandu', addressCountry: 'NP' },
  email: settings.email ? `mailto:${settings.email}` : undefined,
  sameAs: [settings.instagram, settings.instagramPhotos, settings.linkedin, settings.youtube, settings.vimeo].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={theme === 'dark' ? '#0F0F0E' : '#F1F0EC'} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {shareUrl && <meta property="og:image" content={shareUrl.href} />}
    {shareUrl && <meta property="og:image:width" content="1200" />}
    {shareUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <slot name="head" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body id="top" class={theme === 'dark' ? 'theme-night' : ''}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div
      class:list={['scene', { 'scene--grain': grain, 'scene--pad': pad }]}
      style={[sky && `--sky:${sky}`, (ink || theme === 'dark') && `--scene-ink:${ink || '#ECEBE6'}`, navInk && `--nav-ink:${navInk}`].filter(Boolean).join(';')}
    >
      <Nav current={current} note={note} />
      {slug && <p class="slugline"><b>{scene}</b><span>{slug}</span></p>}
      {rail && <span class="rail" aria-hidden="true"></span>}
      <main id="main">
        <slot />
      </main>
    </div>
    <Footer current={current} scene={scene} dark={footerDark} />
  </body>
</html>
