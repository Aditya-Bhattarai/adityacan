# SAFETY: GitHub only receives what this file explicitly allows.
# The first line blocks everything in this folder. The "!" lines let
# specific items through. Anything not listed stays on this PC.
/*

# Allowed to upload
!/.gitignore
!/.node-version
!/README.md
!/START-HERE.md
!/package.json
!/package-lock.json
!/astro.config.mjs
!/wrangler.jsonc
!/public/
!/src/
!/scripts/
!/site-content/

# Personal notes and unapproved work: never upload
/site-content/_UNSORTED.md
/site-content/02-film/cryptid-documentary/

# Never upload, even from inside an allowed folder
node_modules/
dist/
.astro/
.wrangler/
.env*
*.doc
*.docx
*.xls
*.xlsx
*.ai
*.psd
*salary*
*payslip*
*certificate*
*loan*
*cover[-_ ]letter*
*coverletter*
*Investment_Strategy*
*proposal*
*workbook*
*passport*
*citizenship*
*contract*
*invoice*
